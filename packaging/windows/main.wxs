<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal WiX 3 installer: hookecho.exe into Program Files + Start Menu shortcut.
     Version is passed by CI as -dAppVersion=X.Y.Z; UpgradeCode must never change. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="HookEcho"
           Language="1033"
           Version="$(var.AppVersion)"
           Manufacturer="HookEcho project"
           UpgradeCode="25ff064b-8dc5-4675-b924-414268ca1a45">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of HookEcho is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The exe embeds its icon (see build.rs), so Add/Remove Programs and the Start Menu
         shortcut both point at it rather than shipping a second copy of the .ico. -->
    <Icon Id="AppIcon.exe" SourceFile="$(var.ExePath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HookEcho">
          <Component Id="MainExe" Guid="6f9ffb55-9e00-435b-a116-9f88413aa820" Win64="yes">
            <File Id="HookechoExe" Source="$(var.ExePath)" KeyPath="yes" />
          </Component>
          <!-- Shared hookecho:// links open the app, the way they already do on Android. -->
          <Component Id="UrlScheme" Guid="3a1d6c47-58f1-4c6a-9c0e-7d2e5b8a41d3" Win64="yes">
            <RegistryKey Root="HKLM" Key="Software\Classes\hookecho">
              <RegistryValue Type="string" Value="URL:HookEcho" KeyPath="yes" />
              <RegistryValue Name="URL Protocol" Type="string" Value="" />
            </RegistryKey>
            <RegistryValue Root="HKLM" Key="Software\Classes\hookecho\DefaultIcon"
                           Type="string" Value="[INSTALLFOLDER]hookecho.exe,0" />
            <RegistryValue Root="HKLM" Key="Software\Classes\hookecho\shell\open\command"
                           Type="string" Value="&quot;[INSTALLFOLDER]hookecho.exe&quot; &quot;%1&quot;" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="8f0f2f65-1f5e-4bfa-9c2b-51df6ad9f0be">
          <Shortcut Id="AppShortcut" Name="HookEcho"
                    Target="[INSTALLFOLDER]hookecho.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.exe" />
          <RemoveFolder Id="CleanMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\HookEcho" Name="installed"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="UrlScheme" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata. Software centres (GNOME Software, KDE Discover) show nothing useful for an
  app without this file, and Flathub rejects one that has no summary, description or screenshots
  entry — so it lives here rather than in any one packaging format's directory, and the AppImage,
  Flatpak and Snap builds all install this same copy.
-->
<component type="desktop-application">
  <id>zip.batman.hookecho</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Hook Echo-WX</name>
  <summary>Advanced NEXRAD weather radar viewer</summary>

  <description>
    <p>
      A desktop radar viewer that talks straight to the public NEXRAD, MRMS, HRRR and NWS feeds
      from your own machine: no account, no hosted service, no telemetry.
    </p>
    <p>
      Level 2 volumes at every tilt with dual-polarization products, storm-relative velocity and
      dealiasing; the national MRMS mosaic, rotation tracks, hail and flash-flood layers; warnings,
      storm reports, spotters and surface observations over an interactive basemap; Skew-T
      soundings with severe composite parameters; archive playback to 1991; and offline chase
      packs for when the data connection is the thing that fails.
    </p>
  </description>

  <launchable type="desktop-id">hookecho.desktop</launchable>
  <url type="homepage">https://github.com/d4vid87/hookecho</url>
  <url type="bugtracker">https://github.com/d4vid87/hookecho/issues</url>

  <provides>
    <binary>hookecho</binary>
  </provides>

  <categories>
    <category>Science</category>
    <category>Geoscience</category>
    <category>Education</category>
  </categories>

  <keywords>
    <keyword>weather</keyword>
    <keyword>radar</keyword>
    <keyword>nexrad</keyword>
    <keyword>storm</keyword>
    <keyword>forecast</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.7.0" date="2026-08-09"/>
  </releases>
</component>

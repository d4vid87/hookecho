<?xml version="1.0" encoding="utf-8"?>
<!-- 30 minutes is the floor Android allows for a widget's own clock; the alert service pushes
     updates on its own cadence whenever it is running, which is the case that matters. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_alerts" />

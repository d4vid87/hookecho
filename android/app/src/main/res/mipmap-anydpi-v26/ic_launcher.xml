<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the launcher masks the foreground to whatever shape the device uses (circle,
  squircle, teardrop) instead of pasting our own circle onto the home screen. The monochrome layer
  is what themed icons tint, so the app stops being the one full-color hole in a themed home
  screen.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/hookecho_navy" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

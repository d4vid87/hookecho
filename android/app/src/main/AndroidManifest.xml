<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeActivity app: Rust draws everything, and the only Kotlin is the background alert service
  plus the thin `MainActivity` that receives its notification taps (`android:hasCode="true"`).
  The activity loads
  libhookecho.so and calls its `android_main` (see the `android.app.lib_name` meta-data, which must
  match the crate/.so name). `configChanges` keeps rotation/resize in-process so egui just gets a
  resize event instead of an activity restart. `screenOrientation="sensor"` makes the app follow the
  physical device orientation (portrait + both landscapes) — a fullscreen NativeActivity left
  UNSPECIFIED gets pinned to portrait by Samsung's launcher heuristics and never rotates.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only: whether the active link is metered, so mobile data gets a lighter refresh
         cadence and fewer basemap tiles (see `platform::is_metered`). Not a runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Position sharing listens for UDP broadcasts from other Hook Echo instances on the same
         network; Android drops those packets unless the app holds a Wi-Fi multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Chase mode's follow-me: the device's own position, requested at runtime from the poll
         loop in platform.rs. Optional — tapping the map to set your position still works. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Opt-in background alerting (Settings switch, off by default): a foreground service polls
         api.weather.gov for the saved markers so warnings arrive with the app closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The wgpu backend is Vulkan; require Vulkan 1.1 (0x00400003). -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00400003"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Hook Echo-WX">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:screenOrientation="sensor"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="Hook Echo-WX">
            <meta-data
                android:name="android.app.lib_name"
                android:value="hookecho" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

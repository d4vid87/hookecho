<?xml version="1.0" encoding="utf-8"?>
<!--
  GameActivity app: Rust draws everything, and the only Kotlin is the background alert service
  plus the thin `MainActivity` that receives its notification taps (`android:hasCode="true"`).
  The activity loads
  libhookecho.so and calls its `android_main` (see the `android.app.lib_name` meta-data, which must
  match the crate/.so name). `configChanges` keeps rotation/resize in-process so egui just gets a
  resize event instead of an activity restart. `screenOrientation="sensor"` makes the app follow the
  physical device orientation (portrait + both landscapes) — a fullscreen activity left
  UNSPECIFIED gets pinned to portrait by Samsung's launcher heuristics and never rotates.
  `android:theme` is load-bearing: GameActivity descends from AppCompatActivity and refuses to
  start under a non-AppCompat theme. `enableOnBackInvokedCallback` opts into predictive back —
  see the OnBackPressedCallback in MainActivity and the JNI pair in platform.rs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only: whether the active link is metered, so mobile data gets a lighter refresh
         cadence and fewer basemap tiles (see `platform::is_metered`). Not a runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Position sharing listens for UDP broadcasts from other Hook Echo instances on the same
         network; Android drops those packets unless the app holds a Wi-Fi multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Chase mode's follow-me: the device's own position, requested at runtime from the poll
         loop in platform.rs. Optional — tapping the map to set your position still works. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Opt-in background alerting (Settings switch, off by default): a foreground service polls
         api.weather.gov for the saved markers so warnings arrive with the app closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Keeps the CPU up for the duration of one poll pass (not the sleep between them). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Re-arms the WorkManager poll after a reboot; see BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The wgpu backend is Vulkan; require Vulkan 1.1 (0x00400003). -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00400003"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HookEcho"
        android:enableOnBackInvokedCallback="true">
        <!-- singleTask, not the default: `android_main` runs once per process, so a second activity
             instance (a deep link, or relaunching after back) leaves the Rust event loop attached to
             the activity that is gone — the app freezes on its last frame or sits on the splash
             screen forever. One instance means every later launch arrives through onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize"
            android:screenOrientation="sensor"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data
                android:name="android.app.lib_name"
                android:value="hookecho" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared view links: hookecho://goto/SITE,lon,lat,zoom[,RFC3339]. The URL lands in
                 the same goto.txt the notification taps write. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hookecho" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: current alerts at the saved locations, tap to open there. -->
        <receiver
            android:name=".AlertWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alerts_info" />
        </receiver>

        <!-- Home-screen widget: the last radar view the app drew, with its age. No network of
             its own — the app writes the picture, this shows it. -->
        <receiver
            android:name=".RadarWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_radar_info" />
        </receiver>

        <!-- Quick-settings tile: two swipes to the map. -->
        <service
            android:name=".RadarTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot: enqueue the worker only. Android 15 refuses a dataSync FGS from here. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

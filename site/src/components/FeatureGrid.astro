---
import Card from "./Card.astro";

interface Feature {
  eyebrow: string;
  title: string;
  body: string;
}
interface Props {
  features: Feature[];
}
const { features } = Astro.props;
---

<div class="grid">
  {
    features.map((f) => (
      <Card eyebrow={f.eyebrow} title={f.title}>
        <p>{f.body}</p>
      </Card>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
</style>

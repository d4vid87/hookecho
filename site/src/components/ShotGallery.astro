---
interface Shot {
  src: string;
  alt: string;
  caption: string;
}
interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;
---

<div class="gallery">
  {
    shots.map((s) => (
      <figure>
        <img src={s.src} alt={s.alt} loading="lazy" decoding="async" width="1600" height="1000" />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  figure { margin: 0; }
  img {
    display: block;
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    background: var(--bg-deep);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
</style>

---
interface Props {
  title: string;
  accent: string;
  tagline: string;
}

const { title, accent, tagline } = Astro.props;
const lite = "https://app.hookecho.io/lite/";
---

<section class="hero">
  <div class="backdrop" data-lite={lite} aria-hidden="true">
    <picture class="poster">
      <source
        type="image/webp"
        srcset="/shots/reflectivity-640.webp 640w, /shots/reflectivity-1280.webp 1280w"
        sizes="100vw"
      />
      <img
        src="/shots/reflectivity.jpg"
        alt=""
        width="1600"
        height="1000"
        fetchpriority="high"
      />
    </picture>
    <span class="scrim"></span>
  </div>

  <div class="wrap hero-copy">
    <p class="chip">
      <span class="dot" aria-hidden="true"></span>
      <span class="chip-text">Live radar</span>
    </p>
    <h1>{title} <span class="grad-text">{accent}</span></h1>
    <p class="tagline">{tagline}</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/go/web/hero" data-smart-primary data-placement="hero">
        Open live radar
      </a>
      <a class="btn" href="/go/download/hero" data-smart-secondary data-placement="hero">
        Download
      </a>
    </div>
    <p class="fineprint">
      Free and open source. No account or ads.
      <span data-android-note hidden>Android beta · sideloaded APK.</span>
    </p>
  </div>
</section>

<script>
  import { nearbySite } from "../scripts/nearby-site";

  const backdrop = document.querySelector<HTMLElement>(".hero .backdrop");
  const chip = document.querySelector<HTMLElement>(".hero .chip-text");

  if (backdrop?.dataset.lite && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    nearbySite()
      .then((site) => {
        if (!site) return;
        const frame = document.createElement("iframe");
        frame.src = `${backdrop.dataset.lite}?site=${site.id}&hero=1`;
        frame.title = "";
        frame.loading = "eager";
        frame.tabIndex = -1;
        frame.addEventListener("load", () => backdrop.classList.add("has-live"), { once: true });
        backdrop.insertBefore(frame, backdrop.querySelector(".scrim"));

        if (chip) {
          chip.textContent = site.visitorCity
            ? `Live near ${site.visitorCity}`
            : `Live radar · ${site.city}`;
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: clamp(36rem, calc(100svh - 3.75rem), 54rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-block: clamp(4rem, 12vw, 8rem) var(--sp-8);
    color: #f4f7f5;
  }
  .backdrop,
  .backdrop :global(picture),
  .backdrop :global(img),
  .backdrop :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .backdrop :global(img),
  .backdrop :global(iframe) {
    border: 0;
    object-fit: cover;
  }
  .backdrop :global(.poster) { z-index: 0; }
  .backdrop :global(iframe) {
    z-index: 1;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .backdrop.has-live :global(iframe) { opacity: 1; }
  .scrim {
    position: absolute;
    z-index: 2;
    inset: 0;
    background:
      linear-gradient(transparent 15%, rgb(7 11 9 / 0.45) 48%, rgb(7 11 9 / 0.96)),
      linear-gradient(90deg, rgb(7 11 9 / 0.62), transparent 72%),
      radial-gradient(80% 55% at 12% 15%, rgb(48 209 88 / 0.12), transparent 70%);
  }
  .hero-copy { position: relative; z-index: 3; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--sp-4);
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: rgb(7 11 9 / 0.7);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ramp-1);
    box-shadow: 0 0 1rem rgb(48 209 88 / 0.75);
  }
  .hero h1 {
    color: #f4f7f5;
    font-size: clamp(3.3rem, 2rem + 6vw, 7rem);
    font-weight: 760;
    line-height: 0.96;
    letter-spacing: -0.045em;
    max-width: 12ch;
  }
  .tagline {
    color: rgb(244 247 245 / 0.88);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    max-width: 44ch;
  }
  .ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: var(--sp-5) 0 var(--sp-3);
  }
  .hero .btn:not(.btn-primary) {
    background: rgb(17 24 21 / 0.88);
    border-color: rgb(255 255 255 / 0.2);
    color: #f4f7f5;
  }
  .fineprint { color: rgb(244 247 245 / 0.68); font-size: 0.9rem; margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .dot { box-shadow: none; }
  }
  @media (max-width: 560px) {
    .hero { min-height: calc(100svh - 3.75rem); padding-bottom: var(--sp-7); }
    .hero h1 { font-size: clamp(3.1rem, 15vw, 4.25rem); }
    .ctas { align-items: stretch; flex-direction: column; }
    .ctas .btn { justify-content: center; }
  }
</style>

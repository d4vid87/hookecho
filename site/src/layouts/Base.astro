---
import "../styles/global.css";
import "../styles/signal.css";
import "../styles/palette-preview.css";
import PalettePreview from "../components/PalettePreview.astro";
import { palettes, paletteStyles, DEFAULT_PALETTE } from "../data/palettes.js";
import { DISCORD_INVITE } from "../data/community";

interface Props {
  title: string;
  description: string;
  /** Absolute-from-root path to the social card image. */
  image?: string;
  /** schema.org structured data for this page, emitted as ld+json. */
  jsonld?: object;
}

const { title, description, image = "/shots/analyst-mode-20260923.webp", jsonld } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const social = new URL(image, Astro.site);
const analytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const path = Astro.url.pathname;

const nav = [
  { href: "/#weather", label: "Weather" },
  { href: "/radar/", label: "Radar" },
  { href: "/docs/storm-analysis/", label: "Analysis" },
  { href: "/features/", label: "Features" },
  { href: "/roadmap/", label: "Roadmap" },
  { href: "/download/", label: "Download" },
  { href: "/docs/", label: "Learn" },
];

const footer = [
  {
    title: "Product",
    links: [
      { href: "/features/", label: "Capabilities" },
      { href: "/colors/", label: "Color studio" },
      { href: "/compare/", label: "Compare" },
      { href: "/download/", label: "Download" },
      { href: "https://app.hookecho.io/lite/", label: "HookEcho Lite" },
    ],
  },
  {
    title: "Learn",
    links: [
      { href: "/docs/", label: "Documentation" },
      { href: "/docs/storm-analysis/", label: "Advanced storm analysis" },
      { href: "/blog/", label: "Blog" },
      { href: "/radar/", label: "Radar sites" },
      { href: "/storms/", label: "Historic storms" },
      { href: "/glossary/", label: "Glossary" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/d4vid87/hookecho", label: "Star HookEcho on GitHub" },
      { href: "/roadmap/", label: "Roadmap" },
      { href: "/changelog/", label: "Changelog" },
      { href: DISCORD_INVITE, label: "Discord" },
      { href: "https://www.youtube.com/channel/UCZRECVhcCwdr0Fm5Z0NUo7g", label: "HookEcho on YouTube" },
      { href: "https://github.com/d4vid87/hookecho/issues", label: "Report a problem" },
      { href: "/privacy/", label: "Privacy" },
      { href: "/terms/", label: "Terms" },
    ],
  },
];

const current = (href: string) => href.startsWith("/") && (path === href || path.startsWith(href));
---

<!doctype html>
<html lang="en" class="site-signal" data-palette={DEFAULT_PALETTE}>
  <head>
    <link rel="preconnect" href="https://img.hookecho.io" crossorigin />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/logo.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="HookEcho" href="/rss.xml" />
    <meta name="theme-color" content={palettes.find(p => p.id === DEFAULT_PALETTE)!.colors.bg} />
    <style is:inline set:html={paletteStyles} />
    <script is:inline define:vars={{paletteIds: palettes.map(p => p.id)}}>
      (() => {
        const requested = new URLSearchParams(location.search).get('palette');
        let selected = requested;
        try {
          if (requested === null) selected = localStorage.getItem('hookecho:palette-preview');
          else if (paletteIds.includes(requested)) localStorage.setItem('hookecho:palette-preview',requested);
          else if (requested === 'original') localStorage.setItem('hookecho:palette-preview','original');
          else localStorage.removeItem('hookecho:palette-preview');
        } catch {}
        if (paletteIds.includes(selected)) document.documentElement.dataset.palette = selected;
        else if (selected === 'original') delete document.documentElement.dataset.palette;
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/InterVariable-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={social} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}

    {
      analytics && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analytics}"}`}
        />
      )
    }
  </head>
  <body>
    <PalettePreview />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href="/" aria-label="Hookecho home">
          <img src="/logo.png" alt="" width="28" height="28" />
          <span>Hookecho</span>
        </a>

        <nav class="desktop-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="github-star" href="https://github.com/d4vid87/hookecho" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18a4.63 4.63 0 0 1 1.24 3.22c0 4.61-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"/></svg>
            Star on GitHub
          </a>
        </nav>

        <a
          class="btn btn-primary header-cta"
          href="https://app.hookecho.io/"
        >Open live radar</a>

        <details class="site-menu">
          <summary aria-label="Navigation menu">Menu</summary>
          <nav aria-label="Main">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="https://github.com/d4vid87/hookecho" target="_blank" rel="noopener">☆ Star on GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <aside class="analysis-route" aria-label="Explore storm analysis">
      <div class="wrap"><div><p class="eyebrow">Radar → Analyst</p><strong>Read the storm. Check the evidence.</strong><p>Linked products, source times, and a deeper view of severe weather.</p></div><nav aria-label="Analysis resources"><a href="/docs/storm-analysis/">Analysis field guide ↗</a><a href="/roadmap/">Workstation roadmap ↗</a></nav></div>
    </aside>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-about">
          <a class="brand" href="/">
            <img src="/logo.png" alt="" width="28" height="28" />
            <span>Hookecho</span>
          </a>
          <p>
            HookEcho is a free, open-source weather radar built on public data, with no account,
            ads or app telemetry.
          </p>
        </div>
        {
          footer.map((group) => (
            <div class="foot-group">
              <h2>{group.title}</h2>
              <ul>
                {group.links.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </footer>

    <script>
      import { applySmartCtas } from "../scripts/smart-cta.js";
      import "../scripts/motion";

      applySmartCtas(navigator.userAgent);
    </script>
  </body>
</html>

<style>
  .skip-link { position: fixed; top: -5rem; left: 1rem; z-index: 100; padding: .7rem 1rem; background: var(--accent); color: var(--accent-ink); }
  .skip-link:focus { top: .5rem; }

  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg-deep) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--stroke);
  }
  .head-inner {
    min-height: 3.75rem;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    font-weight: 750;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    margin-left: auto;
  }
  .site-menu { display: none; }
  .site-menu summary { display: none; }
  .site-menu nav { display: flex; align-items: center; gap: clamp(0.8rem, 2vw, 1.4rem); }
  .desktop-nav a,
  .site-menu nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.94rem;
    white-space: nowrap;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"],
  .site-menu nav a:hover,
  .site-menu nav a[aria-current="page"] { color: var(--text); }
  .desktop-nav a[aria-current="page"],
  .site-menu nav a[aria-current="page"] { color: var(--accent); text-decoration: underline; text-underline-offset: 0.35rem; }
  .header-cta { flex: none; padding: 0.55rem 1rem; font-size: 0.9rem; }
  .github-star { display: inline-flex; align-items: center; gap: .5rem; padding: 12px; border: 1px solid var(--stroke); }
  .github-star:hover { background: var(--surface-2); }

  .site-foot { border-top: 1px solid var(--stroke); padding: var(--sp-7) 0; background: var(--bg-deep); }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) repeat(3, minmax(8rem, 1fr));
    gap: var(--sp-7);
    align-items: start;
  }
  .foot-about p { color: var(--text-dim); font-size: var(--text-sm); margin-top: var(--sp-4); }
  .foot-group h2 {
    color: var(--text);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    margin-bottom: var(--sp-3);
  }
  .foot-group ul { list-style: none; padding: 0; margin: 0; }
  .foot-group li + li { margin-top: var(--sp-2); }
  .foot-group a { color: var(--text-dim); font-size: var(--text-sm); text-decoration: none; }
  .foot-group a:hover { color: var(--text); text-decoration: underline; }

  @media (max-width: 1150px) {
    .head-inner { gap: var(--sp-3); }
    .desktop-nav { display: none; }
    .site-menu { display: block; order: 3; position: relative; margin-left: 0; }
    .site-menu summary {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      padding: 0.45rem 0.65rem;
      border: 1px solid var(--stroke);
      border-radius: var(--radius-sm);
      color: var(--text);
      font-size: 0.85rem;
      cursor: pointer;
      list-style: none;
    }
    .site-menu summary::-webkit-details-marker { display: none; }
    .site-menu nav {
      display: none;
      position: absolute;
      top: calc(100% + 0.65rem);
      right: 0;
      width: min(18rem, calc(100vw - 2.5rem));
      padding: var(--sp-3);
      border: 1px solid var(--stroke-strong);
      border-radius: var(--radius);
      background: var(--surface-1);
      box-shadow: var(--shadow-2);
    }
    .site-menu[open] nav { display: grid; gap: 0; }
    .site-menu nav a { padding: 0.65rem 0.75rem; border-radius: var(--radius-sm); }
    .site-menu nav a:hover { background: var(--surface-2); }
    .header-cta { margin-left: auto; padding-inline: 0.8rem; }
    .foot-grid { grid-template-columns: repeat(2, 1fr); gap: var(--sp-6); }
    .foot-about { grid-column: 1 / -1; }
  }
  @media (max-width: 360px) {
    .head-inner { gap: var(--sp-2); }
    .brand { gap: 0.35rem; }
    .header-cta { font-size: 0.82rem; }
  }
  @media (max-width: 430px) {
    .head-inner { gap: 0.4rem; }
    .header-cta { padding-inline: 0.55rem; font-size: 0.78rem; white-space: nowrap; }
    .foot-grid { grid-template-columns: 1fr; }
    .foot-about { grid-column: auto; }
  }
</style>

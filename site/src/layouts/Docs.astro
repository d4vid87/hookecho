---
import { getCollection } from "astro:content";
import Base from "./Base.astro";
import "../styles/docs-signal.css";
interface Props {
  title: string;
  description: string;
  current?: string;
  jsonld?: object;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, current, jsonld, headings = [] } = Astro.props;
const pages = (await getCollection("docs")).sort((a,b) => a.data.order - b.data.order);
const groups = [
  {title:"01 / STORM ANALYSIS",ids:["storm-analysis","radar-and-analyst","reading-the-radar","alerts-and-notifications"]},
  {title:"02 / GET SET UP",ids:["getting-started","install","in-your-browser","on-your-phone"]},
  {title:"03 / REFERENCE",ids:["troubleshooting","faq"]},
];
const at = pages.findIndex(p => p.id === current);
const prev = at > 0 ? pages[at-1] : undefined;
const next = at >= 0 && at < pages.length-1 ? pages[at+1] : undefined;
---
<Base title={`${title} — HookEcho docs`} description={description} jsonld={jsonld} >
  <div class="wrap docs-shell">
    <aside class="docs-side">
      <a class="manual-label" href="/docs/">FIELD MANUAL <span>↗</span></a>
      <div id="search" aria-label="Search documentation"></div>
      <nav aria-label="Documentation">
        <a class="docs-home" href="/docs/" aria-current={!current ? "page" : undefined}>Documentation overview</a>
        <details class="guide-menu" open><summary>Browse the manual</summary>
          {groups.map(group => <div class="guide-group"><h2>{group.title}</h2><ul>{group.ids.map(id => {
            const page = pages.find(p => p.id === id);
            return page && <li><a href={`/docs/${page.id}/`} aria-current={page.id === current ? "page" : undefined}>{page.data.title}</a></li>;
          })}</ul></div>)}
        </details>
      </nav>
      <div class="sidebar-project"><a href="/roadmap/">Product roadmap ↗</a><a href="https://github.com/d4vid87/hookecho/issues">Report an issue ↗</a></div>
      <p class="sidebar-note">PUBLIC DATA.<br/>DEEPER UNDERSTANDING.</p>
    </aside>
    <article class:list={["docs-article", {"docs-landing":!current}]} data-pagefind-body>
      <div class="docs-breadcrumb"><a href="/docs/">DOCUMENTATION</a><span>/</span><span>{current ? title : "U.S. STORM ANALYSIS"}</span></div>
      <header class="docs-title"><h1>{current ? title : "Read the storm."}</h1><p class="lead">{description}</p></header>
      {headings.some(h => h.depth === 2) && <nav class="on-page" aria-label="On this page"><span class="doc-label">IN THIS GUIDE</span><ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>}
      <slot/>
      {(prev || next) && <nav class="docs-sequence" aria-label="More documentation">
        {prev ? <a href={`/docs/${prev.id}/`}><span>← PREVIOUS GUIDE</span>{prev.data.title}</a> : <span/>}
        {next && <a href={`/docs/${next.id}/`}><span>NEXT GUIDE →</span>{next.data.title}</a>}
      </nav>}
    </article>
  </div>
</Base>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" media="print" onload="this.media='all'"/>
<script is:inline type="module">
  import("/pagefind/pagefind-ui.js").then(() => {
    new window.PagefindUI({element:"#search",showSubResults:true,showImages:false});
  }).catch(() => {
    document.querySelector("#search").textContent = "Search unavailable. Browse the manual below.";
  });
  if (window.matchMedia("(max-width: 800px)").matches) document.querySelector(".guide-menu").open = false;
</script>

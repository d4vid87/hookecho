---
import {websiteDesigns} from '../../data/website-designs.js';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Ten new directions — HookEcho</title><link rel="icon" href="/logo.png"/></head>
<body class="design-gallery" data-pagefind-ignore>
<header><a class="gallery-brand" href="/">HookEcho <span>/ Design collection</span></a><a href="https://hookecho.io/">Current website ↗</a></header>
<main>
 <div class="gallery-intro"><div><p class="overline">YOUR TASTE VAULT / WEBSITE STUDIES</p><h1>One weather platform.<br/><em>Ten new perspectives.</em></h1><p>Different palettes, menus, layouts, and forecast treatments. Every direction uses the current weather engine, interactive radar, and analysis tools.</p></div><aside><span>START HERE</span><strong>Cirrus · Meridian · Prism</strong><p>My strongest picks: everyday clarity, a focused radar workspace, and a more expressive dashboard.</p></aside></div>
 <div class="gallery-toolbar"><p>Explore a full working design, or jump straight to its weekly forecast.</p><div role="group" aria-label="Preview image view"><button type="button" data-view="overview" aria-pressed="true">Overview</button><button type="button" data-view="week" aria-pressed="false">Weekly forecast</button></div></div>
 <div class="gallery-grid">{websiteDesigns.map(d=><article style={`--card-accent:${d.accent};--card-bg:${d.bg}`}><a class="gallery-image" href={`/designs/${d.id}/`} aria-label={`Explore ${d.name}`}><img src={`/design-studies/${d.id}-overview.jpg`} data-design-image={d.id} alt={`${d.name} overview design with sample weather data`} width="1440" height="1080" loading="lazy"/><span>Explore {d.name} ↗</span></a><div class="gallery-card-body"><div class="card-title"><h2><small>{d.number}</small> {d.name}</h2><div class="swatches" aria-label={d.theme==='dark'?'Dark palette':'Light palette'}>{d.palette.map(c=><i style={`background:${c}`}></i>)}</div></div><p class="layout-label">{d.layout}</p><p>{d.description}</p><p class="reference">FROM YOUR VAULT · {d.reference}</p><div class="card-links"><a href={`/designs/${d.id}/`}>Explore design →</a><a href={`/designs/${d.id}/#week`}>View forecast</a></div></div></article>)}</div>
 <p class="gallery-note">Preview images use sample forecasts and a recorded radar frame for a consistent comparison. Open any design to use live weather and radar. These studies are kept as a design archive. Nocturne is the selected homepage design.</p>
</main><footer>Built from your taste vault · Ten complete homepage directions · HookEcho</footer>
<script>
 const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
 buttons.forEach(button=>button.addEventListener('click',()=>{
  const view=button.dataset.view!;
  buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
  document.querySelectorAll<HTMLImageElement>('[data-design-image]').forEach(image=>{image.src=`/design-studies/${image.dataset.designImage}-${view}.jpg`;image.alt=`${image.dataset.designImage} ${view==='week'?'weekly forecast':'overview'} design with sample weather data`;image.closest('a')!.href=`/designs/${image.dataset.designImage}/${view==='week'?'#week':''}`;});
 }));
</script>
</body></html>
<style>
:global(html){color-scheme:dark;background:#101417}.design-gallery{--bg:#101417;--text:#f4f5ef;--text-dim:#a6b0b6;--stroke:#30383c;color:var(--text);background:var(--bg);font-family:Inter,sans-serif}header{max-width:1600px;margin:auto;display:flex;justify-content:space-between;gap:20px;padding:26px 4vw;border-bottom:1px solid var(--stroke);font-size:12px}a{color:inherit;text-decoration:none}.gallery-brand{font-size:20px;font-weight:750;letter-spacing:-.6px}.gallery-brand span{font-size:12px;font-weight:400;color:var(--text-dim);letter-spacing:0;margin-left:10px}main{max-width:1600px;padding:0 4vw;margin:auto}.gallery-intro{display:grid;grid-template-columns:1fr 310px;gap:70px;align-items:end;padding:70px 0 45px}.overline{font-size:10px;letter-spacing:.18em;font-weight:650;color:#b1dce8}h1{font-size:clamp(36px,4.5vw,68px);line-height:1.04;letter-spacing:-.055em;font-weight:600;margin:20px 0}h1 em{font-style:normal;color:#a6d9e7}.gallery-intro>div>p:last-child{max-width:650px;color:var(--text-dim);font-size:15px;line-height:1.7}aside{padding:24px;border:1px solid #3d525a;border-radius:16px;background:#19242a}aside>span{display:block;font-size:10px;letter-spacing:.14em;color:#a6d9e7}aside strong{display:block;font-size:17px;margin:12px 0}aside p{font-size:13px;color:var(--text-dim);line-height:1.6;margin:0}.gallery-toolbar{display:flex;justify-content:space-between;gap:20px;align-items:center;border-top:1px solid var(--stroke);padding:20px 0 30px}.gallery-toolbar p{font-size:12px;color:var(--text-dim);margin:0}.gallery-toolbar>div{display:flex;gap:4px;background:#20272b;border:1px solid var(--stroke);padding:4px;border-radius:10px}button{background:transparent;color:var(--text-dim);border:0;padding:10px 14px;font:600 12px Inter,sans-serif;border-radius:6px;white-space:nowrap;cursor:pointer;min-height:44px}button[aria-pressed=true]{background:#d8e8ec;color:#17262a}.gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}article{background:#1a2024;border:1px solid var(--stroke);border-radius:16px;overflow:hidden;transition:transform .2s,border-color .2s}article:hover{transform:translateY(-3px);border-color:#76909a}.gallery-image{display:block;position:relative;overflow:hidden;background:var(--card-bg);aspect-ratio:4/3}.gallery-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.gallery-image>span{position:absolute;right:16px;bottom:16px;padding:10px 16px;background:#111b20ed;border:1px solid #ffffff30;color:white;border-radius:30px;font-size:12px;font-weight:600;box-shadow:0 5px 20px #0003}.gallery-card-body{padding:24px}.card-title{display:flex;align-items:center;justify-content:space-between;gap:20px}h2{font-size:28px;letter-spacing:-1px;margin:0}h2 small{font-size:12px;color:#89999f;letter-spacing:0;margin-right:10px}.swatches{display:flex;gap:6px}.swatches i{width:18px;height:18px;display:block;border-radius:50%;border:1px solid #ffffff35}.gallery-card-body p{font-size:14px;line-height:1.6;color:var(--text-dim);margin:12px 0}.gallery-card-body .layout-label{color:#e5edf0;font-size:12px;margin-top:6px}.gallery-card-body .reference{font-size:10px;color:#a6d9e7;letter-spacing:.025em;margin-top:20px}.card-links{display:flex;gap:22px;border-top:1px solid var(--stroke);padding-top:18px;margin-top:18px;font-size:12px;font-weight:600}.card-links a:last-child{color:var(--text-dim)}.gallery-note{font-size:12px;line-height:1.7;color:var(--text-dim);max-width:800px;margin:40px 0}footer{padding:25px 4vw;border-top:1px solid var(--stroke);font-size:11px;color:var(--text-dim)}:focus-visible{outline:3px solid #a6d9e7;outline-offset:4px}@media(max-width:800px){.gallery-intro{grid-template-columns:1fr;gap:20px;padding-top:40px}.gallery-toolbar{align-items:start;flex-direction:column}.gallery-grid{grid-template-columns:1fr;gap:24px}.gallery-brand span{display:none}.gallery-card-body{padding:20px}h2{font-size:25px}}@media(prefers-reduced-motion:reduce){article{transition:none}article:hover{transform:none}}
</style>

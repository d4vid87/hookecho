---
import Base from "../../layouts/Base.astro";
---
<Base title="StormDesk has moved" description="StormDesk continues as a separate open-source project.">
  <section class="wrap moved">
    <p class="eyebrow">Separate project</p>
    <h1>Looking for StormDesk?</h1>
    <p>HookEcho.io now focuses entirely on HookEcho. StormDesk continues as its own open-source project on GitHub.</p>
    <div class="actions"><a class="btn btn-primary" href="https://github.com/d4vid87/stormdesk">Visit StormDesk on GitHub</a><a class="btn" href="/">Back to HookEcho</a></div>
  </section>
</Base>
<style>
  .moved{max-width:760px;padding-block:clamp(5rem,14vw,11rem)}.eyebrow{color:var(--accent);font-weight:700;text-transform:uppercase;font-size:.8rem}h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1;margin:.6rem 0 1.5rem}p{color:var(--text-dim);font-size:1.15rem}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}
</style>

---
import Base from '../../layouts/Base.astro';
import { palettes, paletteVariables, DEFAULT_PALETTE } from '../../data/palettes.js';
---
<Base title="Ten color studies — HookEcho" description="Compare ten color schemes on the selected Signal layout. Try each on the real homepage and across the site.">
  <div class="wrap color-studio">
    <header class="studio-intro">
      <p class="eyebrow">Taste vault / Color studies / Selected: Carbon</p>
      <h1>Same signal.<br />Ten new moods.</h1>
      <div class="studio-description"><p>Your chosen layout, typography, and storm-analysis workflow. Five light palettes. Five dark. Open any study to try it on the real site.</p><a href="/?palette=original">View original Signal ↗</a></div>
      <nav class="studio-nav" aria-label="Palette groups"><a href="#light">01–05 / Light studies ↓</a><a href="#dark">06–10 / Dark studies ↓</a><span>Use the corner switcher to compare on any page.</span></nav>
    </header>
    {['light','dark'].map(mode => <section class="palette-group" id={mode}>
      <div class="group-heading"><h2>{mode === 'light' ? 'Light. With character.' : 'Dark. With intention.'}</h2><span>{mode === 'light' ? '01—05' : '06—10'} / {mode.toUpperCase()}</span></div>
      <div class="palette-grid">{palettes.filter(p=>p.mode===mode).map(p => <article class="palette-card" style={paletteVariables(p)}>
        <a class="study-preview" href={`/?palette=${p.id}`} data-palette-preview={p.id} aria-label={`Preview ${p.name} on the full site`}>
          <div class="mini-head"><strong>hookecho<span>.</span></strong><span>RADAR / ANALYST</span><b>OPEN RADAR ↗</b></div>
          <div class="mini-intro"><div><small>PUBLIC DATA. CLEAR SIGNALS.</small><strong>WEATHER.<br />WITHOUT THE NOISE.</strong></div><div class="mini-search">City or radar station <span>↗</span></div></div>
          <div class="mini-alert">◇ <span>OFFICIAL WEATHER ALERTS</span><span>NWS ↗</span></div>
          <div class="mini-panels"><div class="mini-local"><small>01 / LOCAL OUTLOOK</small><strong>Oklahoma City</strong><div class="mini-reading">72° <span>☀</span></div><small>ILLUSTRATIVE FORECAST</small><div class="mini-outlook">02 / LOCAL FORECAST<br /><b>A look ahead.</b></div></div><div class="mini-radar"><small>03 / HOOKECHO RADAR</small><img src="/shots/radar-mode-20260923.webp" alt="Archived HookEcho radar capture used to compare interface colors" loading="lazy" width="1440" height="900"/><small>ARCHIVED RADAR / COLOR STUDY</small></div></div>
          <span class="preview-cue">Try this on the full site ↗</span>
        </a>
        <div class="study-info"><div><span class="study-number">{String(palettes.indexOf(p)+1).padStart(2,'0')} / {p.mode.toUpperCase()}</span><h3>{p.name}{p.id === DEFAULT_PALETTE && <span class="selected-palette">Selected</span>}</h3></div><div class="swatches" aria-label={`${p.name} colors`}>{[p.colors.bg,p.colors.text,p.colors.action,p.colors.panel].map(c=><span style={`background:${c}`} title={c}></span>)}</div><p>{p.description}</p><a href={`/?palette=${p.id}`}>Preview {p.name} ↗</a></div>
      </article>)}</div>
    </section>)}
    <div class="studio-end"><h2>Follow your eye.</h2><p>Try your favorites on the homepage, documentation, and roadmap. Your preview carries between pages in this browser. Tell me the numbers or names you like.</p><p class="studio-note">Radar imagery and official warning colors stay unchanged. The sample readings above illustrate the layout; open a preview for the actual weather feed.</p><a class="btn" href="/?palette=original">Return to original Signal ↗</a></div>
  </div>
</Base>
<style>
  .selected-palette{display:inline-block;margin-left:12px;vertical-align:middle;font:10px/1.5 'Courier New',monospace;text-transform:uppercase;letter-spacing:.04em;padding:4px 7px;background:var(--palette-action);color:var(--palette-action-ink)}
  .color-studio{padding:55px 0 60px}.studio-intro h1{max-width:20ch}.studio-description{display:flex;justify-content:space-between;align-items:end;gap:30px;margin:25px 0 35px}.studio-description p{color:var(--text-dim);max-width:65ch;margin:0}.studio-description>a{font:12px 'Courier New',monospace;white-space:nowrap}.studio-nav{display:flex;flex-wrap:wrap;gap:28px;border-block:1px solid var(--stroke);padding:20px 0;font:11px/1.6 'Courier New',monospace}.studio-nav a{color:var(--text)}.studio-nav span{margin-left:auto;color:var(--text-dim)}.palette-group{padding:40px 0 15px}.group-heading{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:25px}.group-heading h2{font-size:32px}.group-heading>span{font:11px 'Courier New',monospace;color:var(--text-dim)}.palette-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.palette-card{background:var(--bg);color:var(--text);border:1px solid var(--stroke);min-width:0}.study-preview{position:relative;display:block;padding:22px 22px 0;background:var(--bg);color:var(--text);text-decoration:none;overflow:hidden}.study-preview:hover,.study-preview:focus-visible{outline:3px solid var(--palette-action);outline-offset:-3px}.mini-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-bottom:13px;border-bottom:1px solid var(--stroke);font:7px 'Courier New',monospace}.mini-head strong{font:750 15px Inter,sans-serif;letter-spacing:-.7px}.mini-head strong span{color:var(--accent)}.mini-head b{background:var(--palette-action);color:var(--palette-action-ink);padding:7px}.mini-intro{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 0}.mini-intro strong{display:block;font:850 clamp(18px,2vw,30px)/.95 Inter,sans-serif;letter-spacing:-.05em}.mini-intro small{display:block;font:6px 'Courier New',monospace;letter-spacing:.08em;margin-bottom:10px}.mini-search{border:1px solid var(--stroke);padding:10px;font:7px 'Courier New',monospace;min-width:135px;color:var(--text-dim)}.mini-search span{margin-left:20px}.mini-alert{display:flex;gap:8px;padding:9px;background:var(--palette-dark);color:var(--palette-light);font:6px 'Courier New',monospace}.mini-alert span:last-child{margin-left:auto}.mini-panels{display:grid;grid-template-columns:1fr 2fr;min-height:205px}.mini-panels small{display:block;font:6px/1.5 'Courier New',monospace}.mini-local{background:var(--surface-1);padding:14px 0 0;display:flex;flex-direction:column}.mini-local>small,.mini-local>strong,.mini-reading{margin-inline:14px}.mini-local>strong{display:block;font-size:12px;letter-spacing:-.5px;margin-top:12px}.mini-reading{font-size:48px;font-weight:800;letter-spacing:-3px;line-height:1.4;display:flex;align-items:center;justify-content:space-between;gap:8px}.mini-reading span{font-size:20px;font-weight:400;letter-spacing:0;color:var(--accent)}.mini-outlook{background:var(--palette-action);color:var(--palette-action-ink);padding:12px 14px;font:6px/1.5 'Courier New',monospace;margin-top:15px;flex:1}.mini-outlook b{font:650 16px Inter,sans-serif;display:block;margin-top:8px;letter-spacing:-.6px}.mini-radar{background:var(--palette-dark);color:var(--palette-light);display:flex;flex-direction:column;min-width:0}.mini-radar small{padding:10px 12px}.mini-radar img{width:100%;height:175px;object-fit:cover;flex:1;min-height:0}.preview-cue{position:absolute;bottom:16px;right:16px;padding:10px 14px;background:var(--palette-action);color:var(--palette-action-ink);font:700 10px 'Courier New',monospace;opacity:0;transition:opacity .15s}.study-preview:hover .preview-cue,.study-preview:focus-visible .preview-cue{opacity:1}.study-info{display:grid;grid-template-columns:1fr auto;gap:14px;padding:22px;border-top:1px solid var(--stroke)}.study-number{font:10px 'Courier New',monospace;color:var(--text-dim)}.study-info h3{font-size:28px;margin:9px 0 0;font-weight:700}.swatches{display:flex;align-items:center;gap:5px}.swatches span{width:24px;height:24px;border:1px solid var(--stroke)}.study-info p{grid-column:1/-1;font-size:14px;color:var(--text-dim);margin:0}.study-info>a{grid-column:1/-1;color:var(--accent);font:700 12px 'Courier New',monospace;padding-top:4px}.studio-end{max-width:720px;margin:70px auto 30px;text-align:center}.studio-end p{color:var(--text-dim)}.studio-note{font-size:12px}.studio-end .btn{margin-top:15px}
  @media(max-width:800px){.palette-grid{grid-template-columns:1fr}.mini-intro strong{font-size:32px}.studio-description{align-items:start;flex-direction:column}.studio-nav span{margin-left:0}.group-heading{align-items:start;flex-direction:column;gap:6px}.mini-radar img{height:220px}}
  @media(max-width:450px){.color-studio{padding-top:30px}.study-preview{padding:14px 14px 0}.mini-intro strong{font-size:21px}.mini-search{min-width:0;font-size:6px;padding:7px;max-width:95px}.mini-search span{margin-left:2px}.mini-head>span{display:none}.mini-panels{grid-template-columns:1fr 1.5fr}.mini-local>strong{font-size:10px}.mini-reading{font-size:40px}.mini-reading span{font-size:15px}.mini-outlook{padding:10px}.mini-outlook b{font-size:13px}.mini-radar img{height:170px}.study-info{padding:18px}.swatches span{width:20px;height:20px}.studio-nav{gap:15px}.preview-cue{display:none}}
</style>

---
import { DISCORD_INVITE } from "../data/community";
import Base from "../layouts/Base.astro";

const raw = "https://raw.githubusercontent.com/d4vid87/hookecho/main";
// Keep the press screenshots aligned with the rolling app and GitHub gallery.
const assets = [
  { href: `${raw}/docs/shots/radar-mode.jpg?v=20261111`, label: "Radar Zeta hero", note: "Current single-map interface over archived KTLX radar" },
  { href: `${raw}/docs/shots/analyst-mode.jpg?v=20261111`, label: "Analyst Workstation hero", note: "Four linked radar products and the inspector" },
  { href: `${raw}/docs/shots/radar-mode.gif?v=20261111`, label: "Radar mode GIF", note: "Stepping through archived radar scans" },
  { href: `${raw}/docs/shots/analyst-mode.gif?v=20261111`, label: "Analyst mode GIF", note: "Four linked radar products advancing together" },
  { href: `${raw}/docs/shots/mobile/map.jpg?v=20261111`, label: "Mobile browser", note: "Current responsive web app · 430 × 932 browser viewport · November 11, 2026" },
  { href: `${raw}/docs/shots/mobile/hero.gif?v=20261111`, label: "Mobile radar GIF", note: "Archived Moore radar playback in the responsive web app" },
  { href: `${raw}/docs/shots/android/map.jpg?v=20261111`, label: "Native Android", note: "Radar Focus layout · Android 15 Pixel 7 emulator · November 11, 2026" },
  { href: `${raw}/docs/shots/android/hero.gif?v=20261111`, label: "Native Android radar GIF", note: "Archived Moore playback in the native x86_64 emulator build" },
  { href: "/showcase/android-current.mp4?v=20261111", label: "Native Android radar MP4", note: "540 × 1104 · five seconds · emulator capture" },
  { href: `${raw}/docs/shots/cellconsole.jpg?v=20261111`, label: "Storm dock", note: "Current selected-cell attributes beside the radar" },
  { href: `${raw}/docs/shots/stormtable.jpg?v=20261111`, label: "Storm attributes", note: "Storm list with selected cell details" },
  { href: `${raw}/docs/shots/layers.jpg?v=20261111`, label: "Layers", note: "Floating controls and grouped layers" },
  { href: "https://raw.githubusercontent.com/d4vid87/hookecho/main/assets/brand/hookecho-logo.png", label: "App icon", note: "Current artwork · PNG, 1254×1254" },
  { href: `${raw}/docs/shots/alltilts.jpg?v=20261111`, label: "Four radar views", note: "Reflectivity, velocity and dual-polarization" },
  { href: `${raw}/docs/shots/velocity.jpg?v=20261111`, label: "Raw velocity", note: "Raw base velocity from the archived El Reno storm" },
  { href: `${raw}/docs/shots/alerts.jpg?v=20261111`, label: "Warnings", note: "Archived BMX tornado warning from April 27, 2011; expired today" },
  { href: `${raw}/docs/shots/warning-detail.jpg?v=20261111`, label: "Archived tornado warning", note: "Warning details over the archived Moore storm" },
  { href: `${raw}/docs/shots/mosaic.jpg?v=20261111`, label: "Regional mosaic", note: "Neighboring radar coverage over central Illinois" },
  { href: `${raw}/docs/shots/hrrr.jpg?v=20261111`, label: "Model fields", note: "Recorded HRRR one-hour forecast · valid November 11, 2026 at 18:00 UTC" },
];
---

<Base
  title="Press kit | HookEcho"
  description="Boilerplate, fact sheet and screenshots for writing about HookEcho — the free, open-source NEXRAD weather radar app."
>
  <section>
    <div class="wrap prose">
      <p class="eyebrow">Press</p>
      <h1>Press kit</h1>
      <p class="lede">
        Everything here is free to use in coverage of HookEcho, with credit to the project. No
        permission request needed.
      </p>

      <h2>Boilerplate</h2>
      <blockquote>
        HookEcho is a free, open-source weather radar app for Windows, macOS, Linux, Android and
        the browser. It reads NEXRAD Level 2 volumes, MRMS, HRRR and the National Weather Service
        feeds directly from the public NOAA sources and renders them on the user's own machine —
        every radar tilt, dual-polarization products, storm-relative velocity, warnings and archive
        playback back to 1991 — with no account, no subscription, no ads and no telemetry. It is
        GPL licensed.
      </blockquote>

      <h2>Fact sheet</h2>
      <dl class="facts">
        <div><dt>Name</dt><dd>HookEcho (one word, capital H and E)</dd></div>
        <div><dt>What it is</dt><dd>Desktop, mobile and browser weather radar viewer</dd></div>
        <div><dt>Platforms</dt><dd>Windows, macOS, Linux, Android, any modern browser</dd></div>
        <div><dt>Price</dt><dd>Free. No paid tier, no in-app purchase</dd></div>
        <div><dt>Licence</dt><dd>GPL-3.0</dd></div>
        <div><dt>Data sources</dt><dd>NOAA NEXRAD, MRMS, HRRR/NAM, National Weather Service API</dd></div>
        <div><dt>Coverage</dt><dd>152 NEXRAD sites, 44 TDWR terminal radars, Germany's DWD network</dd></div>
        <div><dt>Archive</dt><dd>Back to 1991</dd></div>
        <div><dt>Source</dt><dd><a href="https://github.com/d4vid87/hookecho">github.com/d4vid87/hookecho</a></dd></div>
      </dl>

      <h2>Where the name comes from</h2>
      <p>
        A hook echo is the comma-shaped appendage on a supercell's radar signature, wrapped around
        the storm's rotating updraft. It was first documented in Illinois in 1953, and it has been
        the classic radar indicator of a possible tornado ever since — the thing a forecaster looks
        for first.
        <a href="/blog/what-is-a-hook-echo/">The longer version.</a>
      </p>

      <h2>Images</h2>
      <p class="dim">
        App icon and screenshots from the current GitHub gallery. Right-click to save; hotlinking is fine too.
      </p>
      <ul class="assets">
        {
          assets.map((asset) => (
            <li>
              <a href={asset.href}>{asset.label}</a> — <span class="dim">{asset.note}</span>
            </li>
          ))
        }
      </ul>

      <h2>Contact</h2>
      <p>
        Questions, corrections and interview requests:
        <a href="https://github.com/d4vid87/hookecho/discussions">GitHub Discussions</a>, the
        <a href={DISCORD_INVITE}>Discord</a>, or open an
        <a href="https://github.com/d4vid87/hookecho/issues">issue</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  /* A wash of the brand ramp behind the opening block, so every page starts as the same
     product rather than a bare column of text. */
  :global(section:first-of-type) {
    background-image: var(--mesh);
    background-repeat: no-repeat;
    background-size: 100% 22rem;
  }
  .prose { max-width: 70ch; }
  .lede { font-size: 1.1rem; color: var(--text-dim); }
  .dim { color: var(--text-dim); }
  blockquote {
    margin: 1.2rem 0;
    padding: 1.2rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-deep);
    border-radius: var(--radius);
  }
  .facts { display: grid; gap: 0.8rem; margin: 1.2rem 0; }
  .facts div { display: grid; grid-template-columns: minmax(120px, 180px) 1fr; gap: 1rem; }
  .facts dt { color: var(--text-dim); }
  .facts dd { margin: 0; }
  .assets { padding-left: 1.1rem; }
  .assets li { margin: 0.4rem 0; }
</style>

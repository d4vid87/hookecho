---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { DISCORD_INVITE } from "../data/community";

const benefits = [
  {
    icon: "broadcast",
    title: "See the rain move",
    body: "Your nearest radar opens already running, so you can see what is coming without setting anything up.",
  },
  {
    icon: "warning-diamond",
    title: "Follow serious weather",
    body: "Warnings, lightning and storm tracks stay on the map, with the full bulletin one tap away.",
  },
  {
    icon: "stack",
    title: "Go deeper when you need to",
    body: "Every tilt, velocity, dual-pol, forecast fields and archive playback are there when the simple view is not enough.",
  },
];

const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HookEcho",
  applicationCategory: "WeatherApplication",
  operatingSystem: "Windows, macOS, Linux, Android, Web",
  url: "https://hookecho.io",
  downloadUrl: "https://hookecho.io/download/",
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "David May" },
  description:
    "A free, open-source weather radar app reading NEXRAD, MRMS, forecast and National Weather Service feeds directly from public sources.",
};
---

<Base
  title="HookEcho — live weather radar, free and open source"
  description="See rain move, follow warnings and open the radar nearest you. HookEcho is free, open source and available in your browser or as an app."
  jsonld={jsonld}
>
  <Hero
    title="See what’s coming."
    accent="Right now."
    tagline="Watch rain move, follow warnings, and tap anywhere for the forecast. Free, with no account or ads."
  />

  <section class="benefits" aria-labelledby="benefits-title">
    <div class="wrap">
      <p class="eyebrow">Weather without the runaround</p>
      <h2 id="benefits-title">Start simple. Go as deep as the storm demands.</h2>
      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article class="benefit">
            <span class="benefit-icon"><Icon name={benefit.icon} size={22} /></span>
            <h3>{benefit.title}</h3>
            <p>{benefit.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="trust" aria-labelledby="trust-title">
    <div class="wrap trust-inner">
      <div>
        <p class="eyebrow">Built in the open</p>
        <h2 id="trust-title">Public weather data. Private by design.</h2>
      </div>
      <ul aria-label="HookEcho promises">
        <li>Direct NOAA and NWS data</li>
        <li>MIT licensed</li>
        <li>No account or ads</li>
        <li>No app telemetry</li>
      </ul>
    </div>
  </section>

  <section class="weatherdesk" aria-labelledby="weatherdesk-title">
    <div class="wrap weatherdesk-card">
      <div class="weatherdesk-copy">
        <p class="eyebrow">Also from us</p>
        <h2 id="weatherdesk-title">Your weather station deserves a better screen.</h2>
        <p>
          WeatherDesk turns Tempest, Ecowitt, Ambient, Davis and more into a whole-home
          dashboard—with HookEcho radar built in.
        </p>
        <p class="station-list">Tempest · Ecowitt · Ambient · Davis · AcuRite · La Crosse</p>
        <a class="btn weatherdesk-button" href="/go/weatherdesk/homepage">Explore WeatherDesk</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset="/shots/weatherdesk-wide-800.webp 800w, /shots/weatherdesk-wide-1600.webp 1600w"
          sizes="(max-width: 760px) calc(100vw - 2.5rem), 55vw"
        />
        <img
          src="/shots/weatherdesk-wide-1600.webp"
          alt="WeatherDesk showing a personal weather dashboard with HookEcho radar"
          width="1600"
          height="670"
          loading="lazy"
        />
      </picture>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="wrap">
      <p class="eyebrow">Your radar is ready</p>
      <h2 id="final-title">Open the weather near you.</h2>
      <p>No signup and no setup questions. The map opens on your area and starts moving.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/go/web/final" data-smart-primary data-placement="final">
          Open live radar
        </a>
        <a class="btn" href="/go/download/final" data-smart-secondary data-placement="final">
          Download
        </a>
      </div>
      <p class="android-note" data-android-note hidden>Android beta · sideloaded APK.</p>
      <p class="community-link">
        Questions, ideas, or storm reports? <a href={DISCORD_INVITE}>Join the Discord server.</a>
        If you find our projects useful, please star
        <a href="https://github.com/d4vid87/hookecho">HookEcho</a> or
        <a href="https://github.com/d4vid87/weatherdesk">WeatherDesk</a> on GitHub.
      </p>
    </div>
  </section>
</Base>

<style>
  .benefits .wrap > h2 { max-width: 18ch; }
  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-7);
  }
  .benefit { border-top: 1px solid var(--stroke-strong); padding-top: var(--sp-5); }
  .benefit-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--sp-5);
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 12%, var(--surface-1));
    color: var(--accent);
  }
  .benefit p { color: var(--text-dim); margin: 0; }
  .trust {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    background: var(--bg-deep);
    border-block: 1px solid var(--stroke);
  }
  .trust-inner {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 1.2fr);
    gap: var(--sp-7);
    align-items: center;
  }
  .trust h2 { margin: 0; }
  .trust ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3) var(--sp-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust li::before { content: "✓"; color: var(--accent); margin-right: 0.55rem; }
  .weatherdesk { background: color-mix(in srgb, #1678c8 6%, var(--bg)); }
  .weatherdesk-card {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(24rem, 1.4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .weatherdesk-copy h2 { max-width: 14ch; }
  .weatherdesk-copy > p:not(.eyebrow, .station-list) {
    color: var(--text-dim);
    font-size: var(--text-lg);
  }
  .station-list { color: #2497e3; font-size: var(--text-sm); font-weight: 650; }
  .weatherdesk-button { background: #1678c8; border-color: #1678c8; color: #fff; }
  .weatherdesk picture,
  .weatherdesk img { display: block; width: 100%; }
  .weatherdesk img {
    border: 1px solid color-mix(in srgb, #2497e3 35%, var(--stroke));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }
  .final-cta { text-align: center; background-image: var(--mesh); }
  .final-cta h2,
  .final-cta p { margin-inline: auto; }
  .final-cta > .wrap > p:not(.eyebrow, .android-note) { color: var(--text-dim); }
  .actions { display: flex; justify-content: center; gap: var(--sp-3); flex-wrap: wrap; }
  .android-note { color: var(--text-dim); font-size: var(--text-sm); margin-top: var(--sp-3); }
  .community-link { color: var(--text-dim); font-size: var(--text-sm); margin-top: var(--sp-5); }
  @media (max-width: 760px) {
    .benefit-grid,
    .trust-inner,
    .weatherdesk-card { grid-template-columns: 1fr; }
    .benefit-grid { gap: var(--sp-6); }
    .trust ul { grid-template-columns: 1fr; }
    .weatherdesk-copy h2 { max-width: 18ch; }
  }
  @media (max-width: 560px) {
    .actions { align-items: stretch; flex-direction: column; }
    .actions .btn { justify-content: center; }
  }
</style>

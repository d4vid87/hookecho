---
import Base from "../layouts/Base.astro";
import DemoMedia from "../components/DemoMedia.astro";
import Icon from "../components/Icon.astro";
import { DISCORD_INVITE } from "../data/community";

const benefits = [
  {
    icon: "broadcast",
    title: "See the rain move",
    body: "Your nearest radar opens already running, so you can see what is coming without setting anything up.",
  },
  {
    icon: "warning-diamond",
    title: "Follow serious weather",
    body: "Warnings, lightning and storm tracks stay on the map, with the full bulletin one tap away.",
  },
  {
    icon: "stack",
    title: "Go deeper when you need to",
    body: "Every tilt, velocity, dual-pol, forecast fields and archive playback are there when the simple view is not enough.",
  },
];

const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HookEcho",
  applicationCategory: "WeatherApplication",
  operatingSystem: "Windows, macOS, Linux, Android, Web",
  url: "https://hookecho.io",
  downloadUrl: "https://hookecho.io/download/",
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "David May" },
  description:
    "A free, open-source weather radar app reading NEXRAD, MRMS, forecast and National Weather Service feeds directly from public sources.",
};
---

<Base
  title="HookEcho — live weather radar, free and open source"
  description="Live NEXRAD radar, weather warnings and powerful storm analysis. Free and open source, with no account or ads."
  jsonld={jsonld}
>
  <section class="radar-hero" aria-labelledby="hero-title">
    <div class="wrap product-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free · Open source</p>
        <h1 id="hero-title">Know what’s coming.</h1>
        <p class="intro">Live NEXRAD radar, weather warnings and powerful storm analysis. No account. No ads.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/go/web/hero" data-smart-primary data-placement="hero">Open live radar <Icon name="arrow-right" /></a>
          <a class="btn" href="/go/download/hero" data-smart-secondary data-placement="hero">Download app</a>
        </div>
        <p class="platforms">Web · Windows · macOS · Linux · Android</p>
        <p class="android-note" data-android-note hidden>Android beta · sideloaded APK.</p>
      </div>
      <figure class="product-preview">
        <DemoMedia gif="/shots/hookecho-hero.gif?v=0dc4ee0" poster="/shots/hookecho-poster.webp?v=0dc4ee0" alt="HookEcho replaying archived radar scans of the Moore storm on May 20, 2013" width={1100} height={688} eager />
        <figcaption>HookEcho archive replay · May 20, 2013</figcaption>
      </figure>
    </div>
  </section>

  <div class="trust">
    <ul class="wrap" aria-label="HookEcho promises">
      <li><Icon name="broadcast" /> NOAA &amp; NWS data</li>
      <li><Icon name="github-logo" /> MIT licensed</li>
      <li><Icon name="crosshair" /> No account or ads</li>
    </ul>
  </div>

  <section class="stormdesk" aria-labelledby="stormdesk-title">
    <div class="wrap product-grid">
      <div>
        <p class="eyebrow">Meet StormDesk</p>
        <h2 id="stormdesk-title">Your station.<br />One clear view.</h2>
        <p class="intro">Station data, forecasts and HookEcho radar in one dashboard.</p>
        <p class="station-list">Works with Tempest, Ecowitt, Ambient, Davis, AcuRite and La Crosse.</p>
        <a class="text-link" href="/go/stormdesk/homepage">Explore StormDesk <Icon name="arrow-right" /></a>
      </div>
      <figure class="product-preview">
        <DemoMedia gif="/shots/stormdesk-hero.gif?v=midnight" poster="/shots/stormdesk-dashboard-1200.webp?v=midnight" alt="StormDesk’s Midnight Glass dashboard with a live clock, weather-alert banner and six instrument gauges, using labeled sample data" height={619} />
        <figcaption>StormDesk in action · Sample station data</figcaption>
      </figure>
    </div>
  </section>

  <section class="phone-demos wrap" id="android" aria-labelledby="android-title">
    <p class="eyebrow">Recorded on Android</p>
    <h2 id="android-title">Both apps, on your phone.</h2>
    <div class="phone-grid">
      <figure class="product-preview">
        <DemoMedia gif="/shots/hookecho-android.gif" poster="/shots/hookecho-android.webp" alt="HookEcho on an Android phone, showing radar and the layers panel" width={400} height={778} />
        <figcaption>HookEcho · Radar and layers</figcaption>
      </figure>
      <figure class="product-preview">
        <DemoMedia gif="/shots/stormdesk-android.gif" poster="/shots/stormdesk-android.webp" alt="StormDesk on an Android phone, showing current conditions and rain history" width={400} height={778} />
        <figcaption>StormDesk · Conditions and history</figcaption>
      </figure>
    </div>
  </section>

  <section class="community wrap" aria-labelledby="community-title">
    <Icon name="github-logo" size={36} />
    <div>
      <h2 id="community-title">Built in the open. Help it grow.</h2>
      <p>If these tools help you, give the projects a star.</p>
    </div>
    <div class="actions">
      <a class="btn" href="/go/hookecho-source/final"><span aria-hidden="true">☆</span> Star HookEcho</a>
      <a class="btn" href="/go/stormdesk-source/final"><span aria-hidden="true">☆</span> Star StormDesk</a>
    </div>
  </section>

  <section class="benefits" aria-labelledby="benefits-title">
    <div class="wrap">
      <p class="eyebrow">Simple to start. Room to explore.</p>
      <h2 id="benefits-title">Go as deep as the storm demands.</h2>
      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article>
            <span class="benefit-icon"><Icon name={benefit.icon} size={24} /></span>
            <h3>{benefit.title}</h3>
            <p>{benefit.body}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href="/features/">Explore all features <Icon name="arrow-right" /></a>
      <p class="community-link">Questions, ideas, or storm reports? <a href={DISCORD_INVITE}>Join the Discord server.</a></p>
    </div>
  </section>
</Base>

<style>
  .radar-hero { padding-block: clamp(2.5rem, 5vw, 4.5rem) 2rem; }
  .product-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .eyebrow { color: var(--accent); font-weight: 650; }
  h1 { font-size: clamp(3rem, 4.5vw, 4.6rem); max-width: 10ch; line-height: 1.04; margin-bottom: 1.5rem; }
  .intro { color: var(--text-dim); font-size: clamp(1rem, 1.5vw, 1.2rem); margin-bottom: 1.75rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .platforms, .android-note { color: var(--text-dim); font-size: 0.82rem; margin: 1.25rem 0 0; }
  .product-preview { margin: 0; min-width: 0; }
  .product-preview a { display: block; border: 1px solid var(--stroke-strong); border-radius: 9px; overflow: hidden; }
  .product-preview a:hover { border-color: var(--accent); }
  .product-preview picture, .product-preview img { display: block; width: 100%; }
  figcaption { color: var(--text-dim); font-size: 0.75rem; text-align: center; padding-top: 0.65rem; }
  .trust { border-block: 1px solid var(--stroke); }
  .trust ul { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; padding: 1rem 0; }
  .trust li { display: flex; align-items: center; justify-content: center; gap: 0.75rem; color: var(--text-dim); font-size: 0.9rem; }
  .trust li + li { border-left: 1px solid var(--stroke); }
  .phone-demos { padding-block: 3rem; }
  .phone-demos h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .phone-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 320px)); justify-content: center; gap: 2rem; margin-top: 2rem; }
  @media (max-width: 560px) { .phone-grid { grid-template-columns: minmax(0, 320px); } }
  .stormdesk { padding-block: 2.5rem 1.5rem; }
  .stormdesk h2 { font-size: clamp(2rem, 3vw, 2.8rem); }
  .station-list { color: var(--text-dim); font-size: 0.85rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; padding-block: 0.6rem; }
  .text-link:hover { text-decoration: underline; }
  .community { display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem 2rem; border: 1px solid var(--stroke-strong); border-radius: 9px; margin-block: 0.5rem 0; }
  .community h2 { font-size: 1.3rem; font-weight: 550; letter-spacing: -0.02em; }
  .community p { margin: 0; font-size: 0.85rem; color: var(--text-dim); }
  .community .actions { margin-left: auto; }
  .benefits { padding-block: 4rem; }
  .benefits h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin: 2rem 0 1rem; }
  .benefit-grid article { border-top: 1px solid var(--stroke); padding-top: 1.5rem; }
  .benefit-icon { color: var(--accent); display: block; margin-bottom: 1rem; }
  .benefit-grid p, .community-link { color: var(--text-dim); font-size: 0.95rem; }
  .community-link { margin-top: 1rem; }
  @media (max-width: 1100px) { .community { flex-wrap: wrap; } .community .actions { margin-left: 0; } }
  @media (max-width: 900px) {
    .product-grid { grid-template-columns: 1fr; gap: 2rem; }
    h1 { max-width: 15ch; }
    .hero-copy { max-width: 36rem; }
    .stormdesk { padding-top: 2.5rem; }
    .benefit-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 560px) {
    .trust ul { grid-template-columns: 1fr; gap: 0.75rem; }
    .trust li + li { border-left: 0; }
    .community { padding: 1.25rem; }
    .actions { width: 100%; }
    .actions .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>

---
import Base from "../layouts/Base.astro";
import GuidedMedia from "../components/GuidedMedia.astro";

const features = [
  { eyebrow: "Storm tracks", title: "See where storms may move.", body: "Turn on projected tracks, choose a storm, and see its approximate path. Arrival ranges appear only when there is enough data to support them.", src: "/showcase/tracks-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "Selected storms, their measurements, and projected tracks near St. Louis", cues: [{ at: 0, text: "Turn on Storm Tracks." }, { at: 4, text: "Select a storm to follow its projected path." }, { at: 8, text: "Treat arrival ranges as approximate, not a promise." }], note: "Live KLSX storm-cell capture · September 16, 2026" },
  { eyebrow: "MRMS", title: "See rain across the country.", body: "Switch to the national reflectivity mosaic for one continuous view of rain and storms—without hopping from radar to radar.", src: "/showcase/mrms-20260916", poster: "/shots/mrms.jpg?v=20260916", alt: "The national MRMS reflectivity mosaic", cues: [{ at: 0, text: "Open MRMS from the tools pane." }, { at: 4, text: "Zoom out for a continuous national rain map." }, { at: 8, text: "Warnings stay visible as you explore." }], note: "Live MRMS capture · September 16, 2026" },
  { eyebrow: "Storm attributes", title: "Explore a storm’s details.", body: "Select a detected storm to inspect its direction, speed, height, hail indicators, and other measurements that the radar actually provides.", src: "/showcase/attributes-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "A storm attributes table with populated KLSX radar measurements", cues: [{ at: 0, text: "Select a detected storm." }, { at: 4, text: "See motion, height, and the strongest indicators first." }, { at: 8, text: "Open the full measurements when you want more detail." }], note: "Live KLSX Level 3 attributes · September 16, 2026" },
  { eyebrow: "Four radar products", title: "See the same storm four ways.", body: "Compare rain intensity, motion toward or away from radar, similarity of radar returns, and variation in measured motion in synchronized panes.", src: "/showcase/products-20260916", poster: "/shots/alltilts.jpg?v=20260916", alt: "Synchronized reflectivity, velocity, correlation coefficient, and spectrum width panes", cues: [{ at: 0, text: "Reflectivity shows rain and hail intensity." }, { at: 3, text: "Velocity shows motion toward or away from radar." }, { at: 6, text: "Correlation coefficient compares the kinds of returns." }, { at: 9, text: "Spectrum width shows variation in measured motion." }], note: "Archive replay · Moore, Oklahoma · May 20, 2013" },
];
const jsonld = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "HookEcho", applicationCategory: "WeatherApplication", operatingSystem: "Windows, macOS, Linux, Android, Web", url: "https://hookecho.io", downloadUrl: "https://hookecho.io/download/", license: "https://www.gnu.org/licenses/gpl-3.0.html", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description: "Free, open-source live weather radar with storm tracks, MRMS, warnings, and storm analysis." };
---
<Base title="HookEcho — see the weather, follow the storm" description="Live radar, storm tracks, MRMS and storm details in a free, open-source app." jsonld={jsonld}>
  <section class="hero"><div class="wrap hero-grid"><div class="hero-copy" data-reveal><p class="eyebrow">Free · Open source · No ads</p><h1>See the weather.<br /><span>Follow the storm.</span></h1><p class="lede">Live radar that stays simple until you want more—storm tracks, nationwide rain, warnings, and deeper tools are ready when you are.</p><div class="actions left"><a class="btn btn-primary" href="/go/web/hero">Open live radar</a><a class="btn" href="/download/">Download</a></div><p class="micro">No account. Public NOAA and NWS data.</p></div><div class="hero-media" data-reveal data-reveal-delay="80"><div class="orb" aria-hidden="true"></div><GuidedMedia src="/showcase/hero-20260916" poster="/shots/hookecho-poster.webp?v=20260916" alt="HookEcho replaying the Moore storm of May 20, 2013" eager cues={[{ at: 0, text: "Watch the loop to see how the storm is moving." }, { at: 4, text: "Warnings and storm details stay on the map." }, { at: 8, text: "Pause or replay whenever you need another look." }]} /><p class="capture">Archive replay · Moore, Oklahoma · May 20, 2013</p></div></div></section>
  <div class="trust"><div class="wrap"><span>NOAA &amp; NWS public data</span><span>Free and open source</span><span>No account or ads</span></div></div>
  <div id="showcase">{features.map((feature, index) => <section class:list={["feature", `feature-${index}`]}><div class="wrap feature-stage" data-reveal><div class="feature-copy"><p class="eyebrow">{feature.eyebrow}</p><h2>{feature.title}</h2><p>{feature.body}</p>{index === 3 && <div class="product-key"><span>Rain intensity</span><span>Motion</span><span>Return similarity</span><span>Motion variation</span></div>}</div><div class="feature-media"><GuidedMedia src={feature.src} poster={feature.poster} alt={feature.alt} cues={feature.cues} /><p class="capture">Guided capture · {feature.note}</p></div></div></section>)}</div>
  <section class="phone"><div class="wrap phone-grid"><div data-reveal><p class="eyebrow">On your phone</p><h2>Powerful tools, still easy to find.</h2><p>Open Layers &amp; tools without leaving the radar, then browse products, national weather, map settings, and preferences. Live radar stays the first action on Android.</p><div class="actions left"><a class="btn btn-primary" href="/go/web/mobile">Open live radar</a><a class="btn" href="/download/">Get the app</a></div></div><div class="device" data-reveal><GuidedMedia phone src="/showcase/phone" poster="/showcase/phone-poster.webp" alt="HookEcho Layers and tools open on a Samsung Galaxy S24 Ultra" cues={[{ at: 0, text: "Start with full-screen radar." }, { at: 2, text: "Open Layers & tools without leaving the map." }, { at: 7, text: "Browse products, national weather, map settings, and preferences." }]} /><p class="capture">Recorded on a Samsung Galaxy S24 Ultra · September 16, 2026</p></div></div></section>
  <section class="invite"><div class="wrap invite-card"><div><p class="eyebrow">Built in the open</p><h2>Like HookEcho? Give it a star on GitHub.</h2><p>Stars help more weather watchers find the project.</p></div><div class="actions"><a class="btn" href="/go/hookecho-source/final">☆ Star HookEcho</a><a class="btn btn-primary" href="/go/web/final">Open live radar</a></div></div></section>
</Base>
<style>
  .eyebrow{color:var(--accent);font-weight:750;letter-spacing:.12em;text-transform:uppercase;font-size:.75rem}.hero{position:relative;overflow:hidden;padding:clamp(2rem,5vw,5rem) 0 2.5rem}.hero-grid{display:grid;grid-template-columns:minmax(20rem,.72fr) minmax(0,1.28fr);align-items:center;gap:clamp(2rem,5vw,5rem)}h1{font-size:clamp(3rem,6.5vw,6.4rem);line-height:.91;letter-spacing:-.06em;margin:.7rem 0 1.4rem}h1 span{color:#a7edff;text-shadow:0 0 35px rgb(82 216 255/.18)}.lede{max-width:610px;color:var(--text-dim);font-size:clamp(1rem,1.6vw,1.22rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center}.actions.left{justify-content:flex-start;margin-top:1.5rem}.micro{color:#7f98aa;font-size:.78rem;margin-top:1rem}.hero-media{position:relative;min-width:0}.orb{position:absolute;width:75%;aspect-ratio:1;border-radius:50%;background:#1db7ec2b;filter:blur(80px);inset:8% 8% auto auto}.hero-media :global(.guided-frame){box-shadow:0 35px 90px #0009,0 0 0 1px #68dcff18,0 0 55px #2ec7fa18}.capture{color:var(--text-dim);text-align:center;font-size:.72rem;margin:.7rem 0 0}.trust{border-block:1px solid var(--stroke);background:rgb(5 16 25/.5);backdrop-filter:blur(14px)}.trust .wrap{display:flex;justify-content:center;gap:clamp(1rem,6vw,5rem);padding-block:1rem;color:#8eabbc;font-size:.8rem}.feature{position:relative;padding:clamp(4.5rem,8vw,7rem) 0}.feature-stage{position:relative}.feature-copy{position:absolute;z-index:2;left:clamp(1rem,4vw,4rem);top:clamp(1rem,4vw,3rem);width:min(390px,calc(100% - 2rem));padding:clamp(1.2rem,2.5vw,2rem);border:1px solid #63dfff33;border-radius:18px;background:rgb(5 16 26/.82);box-shadow:0 22px 70px #0008;backdrop-filter:blur(18px) saturate(125%)}.feature-1 .feature-copy{left:auto;right:clamp(1rem,4vw,4rem)}.feature-2 .feature-stage{display:grid;grid-template-columns:minmax(260px,.55fr) minmax(0,1.25fr);align-items:center;gap:clamp(1.5rem,4vw,4rem)}.feature-2 .feature-copy{position:relative;inset:auto;width:auto}.feature-3 .feature-copy{position:relative;inset:auto;width:auto;max-width:780px;margin:0 auto 2rem;text-align:center;background:transparent;border:0;box-shadow:none;backdrop-filter:none}.feature-copy h2,.phone h2,.invite h2{font-size:clamp(2rem,4vw,3.6rem);line-height:1.02;margin:.45rem 0 1rem;letter-spacing:-.035em}.feature-copy>p:last-of-type,.phone p,.invite p{color:var(--text-dim);font-size:1.03rem}.feature-media{min-width:0}.product-key{display:flex;justify-content:center;gap:.5rem;flex-wrap:wrap;margin-top:1.4rem}.product-key span{border:1px solid var(--stroke);border-radius:999px;padding:.4rem .7rem;color:#b6c8d4;font-size:.75rem}.phone{padding:clamp(4rem,8vw,7rem) 0;background:radial-gradient(circle at 72% 48%,rgb(31 165 218/.18),transparent 30%)}.phone-grid{display:grid;grid-template-columns:1fr minmax(280px,420px);gap:clamp(3rem,9vw,9rem);align-items:center}.device{padding:14px;border:1px solid #4ecdf45c;border-radius:40px;background:linear-gradient(145deg,#1d3342,#07111a 35% 70%,#183246);box-shadow:0 35px 90px #0009,0 0 45px #32c9f51a}.device :global(.guided-frame){border-radius:28px}.invite{padding:0 0 clamp(4rem,9vw,8rem)}.invite-card{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,3.5rem);border:1px solid #5ddcff52;border-radius:24px;background:linear-gradient(130deg,rgb(16 45 62/.86),rgb(7 19 29/.82));box-shadow:0 30px 80px #0007, inset 0 1px #b3efff1c;backdrop-filter:blur(18px)}.invite h2{font-size:clamp(1.7rem,3vw,2.7rem)}
  @media(max-width:800px){.hero{padding:1rem 0 1.5rem}.hero-grid,.phone-grid,.feature-2 .feature-stage{grid-template-columns:1fr}.hero-grid{gap:1rem}h1{font-size:clamp(2.25rem,10.5vw,3.2rem);line-height:.92;margin:.45rem 0 .8rem}.lede{font-size:.94rem;line-height:1.45}.hero-copy .actions{margin-top:.85rem}.micro{margin:.65rem 0 0;font-size:.7rem}.hero-media{margin-top:.25rem}.feature-copy,.feature-1 .feature-copy{position:relative;inset:auto;width:auto;margin:0 0 1rem}.feature{padding:3.8rem 0}.invite-card{display:grid}.invite .actions{justify-content:flex-start}.trust .wrap{display:grid;text-align:center;gap:.35rem}.phone-grid{gap:2.5rem}.device{width:min(100%,360px);margin:auto}}
</style>

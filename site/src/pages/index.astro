---
import Base from "../layouts/Base.astro";
import GuidedMedia from "../components/GuidedMedia.astro";

const features = [
  { eyebrow: "Storm tracks", title: "See where storms may move.", body: "Turn on projected tracks, choose a storm, and see its approximate path. Arrival ranges appear only when there is enough data to support them.", src: "/showcase/tracks-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "Selected storms, their measurements, and projected tracks near St. Louis", cues: [{ at: 0, text: "Turn on Storm Tracks." }, { at: 4, text: "Select a storm to follow its projected path." }, { at: 8, text: "Treat arrival ranges as approximate, not a promise." }], note: "Live KLSX storm-cell capture · September 16, 2026" },
  { eyebrow: "MRMS", title: "See rain across the country.", body: "Switch to the national reflectivity mosaic for one continuous view of rain and storms—without hopping from radar to radar.", src: "/showcase/mrms-20260916", poster: "/shots/mrms.jpg?v=20260916", alt: "The national MRMS reflectivity mosaic", cues: [{ at: 0, text: "Open MRMS from the tools pane." }, { at: 4, text: "Zoom out for a continuous national rain map." }, { at: 8, text: "Warnings stay visible as you explore." }], note: "Live MRMS capture · September 16, 2026" },
  { eyebrow: "Storm attributes", title: "Explore a storm’s details.", body: "Select a detected storm to inspect its direction, speed, height, hail indicators, and other measurements that the radar actually provides.", src: "/showcase/attributes-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "A storm attributes table with populated KLSX radar measurements", cues: [{ at: 0, text: "Select a detected storm." }, { at: 4, text: "See motion, height, and the strongest indicators first." }, { at: 8, text: "Open the full measurements when you want more detail." }], note: "Live KLSX Level 3 attributes · September 16, 2026" },
  { eyebrow: "Four radar products", title: "See the same storm four ways.", body: "Compare rain intensity, motion toward or away from radar, similarity of radar returns, and variation in measured motion in synchronized panes.", src: "/showcase/products-20260916", poster: "/shots/alltilts.jpg?v=20260916", alt: "Synchronized reflectivity, velocity, correlation coefficient, and spectrum width panes", cues: [{ at: 0, text: "Reflectivity shows rain and hail intensity." }, { at: 3, text: "Velocity shows motion toward or away from radar." }, { at: 6, text: "Correlation coefficient compares the kinds of returns." }, { at: 9, text: "Spectrum width shows variation in measured motion." }], note: "Archive replay · Moore, Oklahoma · May 20, 2013" },
];
const jsonld = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "HookEcho", applicationCategory: "WeatherApplication", operatingSystem: "Windows, macOS, Linux, Android, Web", url: "https://hookecho.io", downloadUrl: "https://hookecho.io/download/", license: "https://www.gnu.org/licenses/gpl-3.0.html", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description: "Free, open-source live weather radar with storm tracks, MRMS, warnings, and storm analysis." };
---
<Base title="HookEcho — see the weather, follow the storm" description="Live radar, storm tracks, MRMS and storm details in a free, open-source app." jsonld={jsonld}>
  <section class="hero"><div class="wrap hero-copy"><p class="eyebrow">Free · Open source · No ads</p><h1>See the weather.<br />Follow the storm.</h1><p class="lede">HookEcho opens live radar right away, then gives you storm tracks, nationwide rain, warnings, and deeper tools when you need them.</p><div class="actions"><a class="btn btn-primary" href="/go/web/hero">Open live radar</a><a class="btn" href="/download/">Download</a></div></div><div class="wrap hero-media"><GuidedMedia src="/showcase/hero-20260916" poster="/shots/hookecho-poster.webp?v=20260916" alt="HookEcho replaying the Moore storm of May 20, 2013" eager cues={[{ at: 0, text: "Watch the loop to see how the storm is moving." }, { at: 4, text: "Warnings and storm details stay on the map." }, { at: 8, text: "Pause or replay whenever you need another look." }]} /><p class="capture">Archive replay · Moore, Oklahoma · May 20, 2013</p></div></section>
  <div class="trust"><div class="wrap"><span>NOAA &amp; NWS public data</span><span>Free and open source</span><span>No account or ads</span></div></div>
  <div id="showcase">{features.map((feature, index) => <section class:list={["feature", { flip: index % 2 }]}><div class="wrap feature-grid"><div class="feature-copy"><p class="eyebrow">{feature.eyebrow}</p><h2>{feature.title}</h2><p>{feature.body}</p></div><div><GuidedMedia src={feature.src} poster={feature.poster} alt={feature.alt} cues={feature.cues} /><p class="capture">{feature.note}</p></div></div></section>)}</div>
  <section class="phone"><div class="wrap phone-grid"><div><p class="eyebrow">On your phone</p><h2>Powerful tools, still easy to find.</h2><p>Open Layers &amp; tools without leaving the radar, then browse products, national weather, map settings, and preferences. Live radar stays the first action on Android.</p><div class="actions left"><a class="btn btn-primary" href="/go/web/mobile">Open live radar</a><a class="btn" href="/download/">Get the app</a></div></div><div><GuidedMedia phone src="/showcase/phone" poster="/showcase/phone-poster.webp" alt="HookEcho Layers and tools open on a Samsung Galaxy S24 Ultra" cues={[{ at: 0, text: "Start with full-screen radar." }, { at: 2, text: "Open Layers & tools without leaving the map." }, { at: 7, text: "Browse products, national weather, map settings, and preferences." }]} /><p class="capture">Recorded on a Samsung Galaxy S24 Ultra · September 16, 2026</p></div></div></section>
  <section class="invite"><div class="wrap invite-card"><div><p class="eyebrow">Built in the open</p><h2>Like HookEcho? Give it a star on GitHub.</h2><p>Stars help more weather watchers find the project.</p></div><div class="actions"><a class="btn" href="/go/hookecho-source/final">☆ Star HookEcho</a><a class="btn btn-primary" href="/go/web/final">Open live radar</a></div></div></section>
</Base>
<style>
  .hero{padding:clamp(3rem,8vw,7rem) 0 2rem;background:radial-gradient(70% 55% at 50% 30%,rgb(45 116 170/.2),transparent 75%)}.hero-copy{text-align:center;max-width:850px}.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.78rem}h1{font-size:clamp(3rem,8vw,7rem);line-height:.95;letter-spacing:-.055em;margin:.5rem 0 1.5rem}.lede{max-width:690px;margin:0 auto 1.7rem;color:var(--text-dim);font-size:clamp(1rem,2vw,1.25rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center}.actions.left{justify-content:flex-start;margin-top:1.5rem}.hero-media{margin-top:clamp(2rem,5vw,4rem);max-width:1250px}.capture{color:var(--text-dim);text-align:center;font-size:.75rem;margin:.7rem 0 0}.trust{border-block:1px solid var(--stroke)}.trust .wrap{display:flex;justify-content:center;gap:clamp(1rem,6vw,5rem);padding-block:1rem;color:var(--text-dim);font-size:.85rem}.feature{padding:clamp(4rem,9vw,8rem) 0}.feature:nth-child(even){background:rgb(255 255 255/.018);border-block:1px solid var(--stroke)}.feature-grid{display:grid;grid-template-columns:minmax(16rem,.65fr) minmax(0,1.35fr);gap:clamp(2rem,6vw,6rem);align-items:center}.flip .feature-copy{order:2}.feature-copy h2,.phone h2,.invite h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1.05;margin:.5rem 0 1rem}.feature-copy>p:last-child,.phone p,.invite p{color:var(--text-dim);font-size:1.05rem}.phone{padding:clamp(4rem,9vw,8rem) 0;background:radial-gradient(circle at 75% 50%,rgb(45 116 170/.16),transparent 35%)}.phone-grid{display:grid;grid-template-columns:1fr minmax(260px,380px);gap:clamp(3rem,10vw,10rem);align-items:center}.invite{padding:0 0 clamp(4rem,9vw,8rem)}.invite-card{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,3.5rem);border:1px solid var(--stroke-strong);border-radius:20px;background:rgb(17 30 43/.65);backdrop-filter:blur(18px)}.invite h2{font-size:clamp(1.7rem,3vw,2.6rem)}
  @media(max-width:800px){.feature-grid,.phone-grid{grid-template-columns:1fr}.flip .feature-copy{order:0}.invite-card{display:grid}.invite .actions{justify-content:flex-start}.trust .wrap{display:grid;text-align:center}}
</style>

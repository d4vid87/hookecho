---
import Base from "../layouts/Base.astro";
import AnalystDemo from "../components/AnalystDemo.astro";
import WeatherOverview from "../components/WeatherOverview.astro";
import GuidedMedia from "../components/GuidedMedia.astro";
import { DISCORD_INVITE } from "../data/community";

const features = [
  { title: "Follow a storm", label: "Storm tracks", body: "Select a detected storm to see where its projected track may lead. Arrival ranges appear only when the data supports them.", src: "/showcase/tracks-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "Selected storm and projected track near St. Louis", source: "KLSX capture · September 16, 2026" },
  { title: "Inspect the details", label: "Storm attributes", body: "Open the measurements behind a detected storm: motion, height, and available hail indicators.", src: "/showcase/attributes-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "Storm attributes in HookEcho", source: "KLSX Level 3 capture · September 16, 2026" },
  { title: "See the whole country", label: "National radar", body: "Switch to the MRMS mosaic for a continuous view of rain and storms across the United States.", src: "/showcase/mrms-20260916", poster: "/shots/mrms.jpg?v=20260916", alt: "National MRMS radar mosaic in HookEcho", source: "MRMS capture · September 16, 2026" },
];
const jsonld = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "HookEcho", applicationCategory: "WeatherApplication", operatingSystem: "Windows, macOS, Linux, Android, Web", url: "https://hookecho.io", downloadUrl: "https://hookecho.io/download/", license: "https://www.gnu.org/licenses/gpl-3.0.html", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description: "Free, open-source weather radar with four-product Analyst views and storm tools." };
---
<Base title="Hookecho — free radar and open-source storm analysis" description="Free, open-source weather radar and a full analysis suite. Explore storm tools, compare linked radar products, and investigate the details with Hookecho." image="/showcase/clinton-four.webp" jsonld={jsonld}>
  <WeatherOverview />

  <section class="analyst-section"><div class="wrap"><AnalystDemo /></div></section>

  <section class="capabilities" id="showcase">
    <div class="wrap">
      <div class="section-intro"><p class="eyebrow">Advanced storm analysis</p><h2>Follow the storm from the big picture to the details.</h2><p>Compare products, inspect storm attributes, and check the source time. Move between Radar and Analyst as your question changes.</p></div>
      <div class="capability-layout" data-feature-showcase>
        <div class="feature-choices" role="group" aria-label="Explore HookEcho capabilities">
          {features.map((feature, index) => <button type="button" data-feature={index} aria-pressed={index === 0 ? "true" : "false"}><span>0{index + 1} / {feature.label}</span><strong>{feature.title}</strong><small>{feature.body}</small></button>)}
        </div>
        <div class="feature-display">
          <div class="feature-frame"><img data-feature-image src={features[0].poster} alt={features[0].alt} width="1280" height="800" loading="lazy" /><video data-feature-video muted loop playsinline preload="none" controls poster={features[0].poster} aria-label={features[0].alt}><source data-feature-source type="video/mp4" /></video></div>
          <div class="feature-caption"><span data-feature-source-label>{features[0].source}</span><button type="button" data-feature-play>Play capture</button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="anywhere"><div class="wrap anywhere-grid">
    <div class="anywhere-copy"><p class="eyebrow">On your screen</p><h2>Take the radar with you.</h2><p>Keep the map in view on your phone, then open the controls when you need them. Use HookEcho in a browser or install it on Android, Windows, macOS, or Linux.</p><div class="actions"><a class="btn btn-primary" href="https://app.hookecho.io/">Open live radar</a><a class="btn" href="/download/">Download HookEcho</a></div></div>
    <div class="phone-capture"><GuidedMedia phone src="/showcase/phone-current" poster="/showcase/phone-current-poster.webp" alt="Current HookEcho Android app on a Galaxy S24 Ultra switching from reflectivity to velocity, opening Layers, and configuring Analyst panes" cues={[{ at: 0, text: "Start with the radar map." }, { at: 4, text: "Switch from Reflectivity to Velocity." }, { at: 8, text: "Open Layers for weather overlays." }, { at: 12, text: "Choose an Analyst pane layout." }]} /><p>Recorded on a Samsung Galaxy S24 Ultra · September 23, 2026 · Archived KTLX radar</p></div>
  </div></section>

  <section class="closing"><div class="wrap closing-inner"><p class="eyebrow">Built in the open</p><h2>The data is public.<br /><span>The radar is yours.</span></h2><p>Free and open source. NOAA and NWS public data. No account, ads, or app telemetry.</p><div class="actions"><a class="btn btn-primary" href="https://app.hookecho.io/">Open live radar <span aria-hidden="true">↗</span></a><a href="https://github.com/d4vid87/hookecho">View on GitHub</a><a href={DISCORD_INVITE}>Join Discord</a></div></div></section>
</Base>

<script>
  const features = [
    { poster: "/shots/stormtable.jpg?v=20260916", src: "/showcase/tracks-20260916.mp4", alt: "Selected storm and projected track near St. Louis", source: "KLSX capture · September 16, 2026" },
    { poster: "/shots/stormtable.jpg?v=20260916", src: "/showcase/attributes-20260916.mp4", alt: "Storm attributes in HookEcho", source: "KLSX Level 3 capture · September 16, 2026" },
    { poster: "/shots/mrms.jpg?v=20260916", src: "/showcase/mrms-20260916.mp4", alt: "National MRMS radar mosaic in HookEcho", source: "MRMS capture · September 16, 2026" },
  ];
  const box = document.querySelector<HTMLElement>("[data-feature-showcase]");
  if (box) {
    const buttons = [...box.querySelectorAll<HTMLButtonElement>("[data-feature]")];
    const image = box.querySelector<HTMLImageElement>("[data-feature-image]")!;
    const video = box.querySelector<HTMLVideoElement>("[data-feature-video]")!;
    const source = box.querySelector<HTMLSourceElement>("[data-feature-source]")!;
    const label = box.querySelector<HTMLElement>("[data-feature-source-label]")!;
    const play = box.querySelector<HTMLButtonElement>("[data-feature-play]")!;
    buttons.forEach((button, index) => button.addEventListener("click", () => {
      video.pause(); video.hidden = true; image.hidden = false;
      source.removeAttribute("src"); video.load();
      image.src = features[index].poster; image.alt = features[index].alt;
      video.poster = features[index].poster; video.setAttribute("aria-label", features[index].alt);
      label.textContent = features[index].source;
      buttons.forEach((item, i) => item.setAttribute("aria-pressed", String(i === index)));
      play.textContent = "Play capture";
    }));
    play.addEventListener("click", () => {
      if (!video.paused) { video.pause(); play.textContent = "Play capture"; return; }
      const index = buttons.findIndex((button) => button.getAttribute("aria-pressed") === "true");
      if (!source.src) { source.src = features[index].src; video.load(); }
      video.hidden = false; image.hidden = true;
      video.play().then(() => { play.textContent = "Pause capture"; }).catch(() => { video.hidden = true; image.hidden = false; });
    });
    video.addEventListener("error", () => { video.hidden = true; image.hidden = false; play.textContent = "Play capture"; });
    video.hidden = true;
  }
</script>

<style>
  .actions{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;margin-top:1.7rem}.analyst-section{padding-block:clamp(4rem,7vw,7rem);background:var(--bg)}.section-intro{max-width:760px;margin-bottom:2.5rem}.section-intro h2{font-size:clamp(2.4rem,4.5vw,4.7rem);line-height:1.02;letter-spacing:-.06em}.section-intro>p:last-child{color:var(--text-dim);font-size:1.1rem}.capabilities{background:var(--bg-deep)}.capability-layout{display:grid;grid-template-columns:minmax(270px,.55fr) minmax(0,1.45fr);gap:2rem;align-items:start}.feature-choices{border-top:1px solid var(--stroke)}.feature-choices button{display:block;text-align:left;width:100%;padding:1.3rem .5rem;border:0;border-bottom:1px solid var(--stroke);background:transparent;color:var(--text);font:inherit;cursor:pointer}.feature-choices button:hover,.feature-choices button[aria-pressed=true]{background:var(--surface-1);padding-left:1rem}.feature-choices button[aria-pressed=true]{box-shadow:inset 3px 0 var(--accent)}.feature-choices span{display:block;color:var(--accent);font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.feature-choices strong{display:block;font-size:1.35rem;letter-spacing:-.025em;margin:.3rem 0}.feature-choices small{display:block;color:var(--text-dim);font-size:.9rem;line-height:1.45}.feature-frame{aspect-ratio:16/10;background:#000;border:1px solid var(--stroke-strong);overflow:hidden}.feature-frame img,.feature-frame video{width:100%;height:100%;object-fit:cover;display:block}.feature-frame [hidden]{display:none}.feature-caption{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:var(--text-dim);font-size:.78rem;margin-top:.5rem}.feature-caption button{border:1px solid var(--stroke-strong);background:var(--surface-1);color:var(--text);border-radius:5px;padding:.5rem .7rem;cursor:pointer}.anywhere{background:var(--bg);overflow:hidden}.anywhere-grid{display:grid;grid-template-columns:1fr minmax(300px,420px);gap:clamp(3rem,9vw,9rem);align-items:center}.anywhere-copy h2,.closing h2{font-size:clamp(2.8rem,5vw,5rem);line-height:1;letter-spacing:-.06em}.anywhere-copy>p:not(.eyebrow),.closing-inner>p:not(.eyebrow){color:var(--text-dim);font-size:1.08rem}.phone-capture{max-width:390px;margin:auto}.phone-capture>p{font-size:.73rem;color:var(--text-dim);text-align:center;margin:.6rem 0 0}.closing{background:var(--surface-2);border-top:1px solid var(--stroke);text-align:center;padding-block:clamp(5rem,10vw,9rem)}.closing h2 span{color:var(--accent)}.closing-inner>p,.closing-inner>.actions{margin-inline:auto;justify-content:center}.closing .actions>a:not(.btn){color:var(--text-dim);font-size:.9rem}.closing .actions>a:not(.btn):hover{color:var(--text)}
  @media(max-width:800px){.capability-layout,.anywhere-grid{grid-template-columns:1fr}.feature-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--stroke)}.feature-choices button{border:0;background:var(--bg-deep);padding:.8rem}.feature-choices button:hover,.feature-choices button[aria-pressed=true]{padding-left:.8rem}.feature-choices strong{font-size:1rem}.feature-choices small{display:none}.anywhere-grid{gap:2rem}}
  @media(max-width:540px){.feature-choices span{font-size:.63rem}.feature-choices strong{font-size:.9rem}.feature-caption{align-items:start;flex-direction:column}.phone-capture{width:min(100%,350px)}}
</style>

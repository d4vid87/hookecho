---
import Base from "../layouts/Base.astro";
import GuidedMedia from "../components/GuidedMedia.astro";
import { DISCORD_INVITE } from "../data/community";

const features = [
  { eyebrow: "Storm tracks", title: "See where storms may move.", body: "Turn on projected tracks, choose a storm, and see its approximate path. Arrival ranges appear only when there is enough data to support them.", src: "/showcase/tracks-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "Selected storms, their measurements, and projected tracks near St. Louis", cues: [{ at: 0, text: "Turn on Storm Tracks." }, { at: 4, text: "Select a storm to follow its projected path." }, { at: 8, text: "Treat arrival ranges as approximate, not a promise." }], note: "Live KLSX storm-cell capture · September 16, 2026" },
  { eyebrow: "MRMS", title: "See rain across the country.", body: "Switch to the national reflectivity mosaic for one continuous view of rain and storms—without hopping from radar to radar.", src: "/showcase/mrms-20260916", poster: "/shots/mrms.jpg?v=20260916", alt: "The national MRMS reflectivity mosaic", cues: [{ at: 0, text: "Open Overlays and select MRMS." }, { at: 4, text: "Zoom out for a continuous national rain map." }, { at: 8, text: "Warnings stay visible as you explore." }], note: "Live MRMS capture · September 16, 2026" },
  { eyebrow: "Storm attributes", title: "Explore a storm’s details.", body: "Select a detected storm to inspect its direction, speed, height, hail indicators, and other measurements that the radar actually provides.", src: "/showcase/attributes-20260916", poster: "/shots/stormtable.jpg?v=20260916", alt: "A storm attributes table with populated KLSX radar measurements", cues: [{ at: 0, text: "Select a detected storm." }, { at: 4, text: "See motion, height, and the strongest indicators first." }, { at: 8, text: "Open the full measurements when you want more detail." }], note: "Live KLSX Level 3 attributes · September 16, 2026" },
  { eyebrow: "Four radar products", title: "See the same storm four ways.", body: "Compare rain intensity, motion toward or away from radar, similarity of radar returns, and variation in measured motion in synchronized panes.", src: "/showcase/products-20260916", poster: "/shots/alltilts.jpg?v=20260916", alt: "Synchronized reflectivity, velocity, correlation coefficient, and spectrum width panes", cues: [{ at: 0, text: "Reflectivity shows rain and hail intensity." }, { at: 3, text: "Velocity shows motion toward or away from radar." }, { at: 6, text: "Correlation coefficient compares the kinds of returns." }, { at: 9, text: "Spectrum width shows variation in measured motion." }], note: "Archive replay · Moore, Oklahoma · May 20, 2013" },
];
const jsonld = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "HookEcho", applicationCategory: "WeatherApplication", operatingSystem: "Windows, macOS, Linux, Android, Web", url: "https://hookecho.io", downloadUrl: "https://hookecho.io/download/", license: "https://www.gnu.org/licenses/gpl-3.0.html", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description: "Free, open-source live weather radar with storm tracks, MRMS, warnings, and storm analysis." };
---
<Base title="HookEcho — radar first, analysis when you need it" description="A clear live radar map and an optional four-pane Analyst Workstation. Free, open source, and easy to switch between." image="/shots/radar-mode-20260923.webp" jsonld={jsonld}>
  <section class="hero"><div class="wrap hero-grid"><div class="hero-copy" data-reveal><p class="eyebrow">Free · Open source · No ads</p><h1>Radar first.<br /><span>Go deeper anytime.</span></h1><p class="lede">Start with one clear radar map. Open Analyst when you need linked panes and precise storm details, then return to your radar view in one click.</p><div class="actions left"><a class="btn btn-primary" href="/go/web/hero">Open live radar</a><a class="btn" href="/docs/radar-and-analyst/">See how it works</a></div><div class="community-links" aria-label="HookEcho community"><a href="/go/hookecho-source/hero">☆ Star on GitHub</a><a href={DISCORD_INVITE}>Join Discord</a></div><p class="micro">No account. Public NOAA and NWS data.</p></div><div class="hero-media" data-reveal data-reveal-delay="80"><div class="orb" aria-hidden="true"></div><GuidedMedia src="/showcase/radar-mode-20260923" poster="/shots/radar-mode-20260923.webp" alt="Radar mode showing an archived Oklahoma storm, the fixed mode switch, and the short Radar panel" eager cues={[{ at: 0, text: "The radar map opens uncluttered." }, { at: 1, text: "Open Radar for site, product, tilt and threshold." }, { at: 3, text: "Close the panel and keep the map." }]} /><p class="capture">Actual app capture · KTLX archive · May 20, 2013</p></div></div></section>
  <div class="trust"><div class="wrap"><span>NOAA &amp; NWS public data</span><span>Free and open source</span><span>No account or ads</span></div></div>
  <section class="mode-feature"><div class="wrap mode-grid" data-reveal><div><p class="eyebrow">Analyst Workstation</p><h2>Four views. One storm. Your radar view is waiting.</h2><p>Switch to Analyst for linked maps and time, a four-pane preset, active-pane controls and an inspector that shows the actual product and data time. Switch back to Radar and your original single map returns.</p><div class="actions left"><a class="btn btn-primary" href="/docs/radar-and-analyst/">Learn Analyst mode</a><a class="btn" href="/features/#analyst-mode">Explore the tools</a></div></div><div><GuidedMedia src="/showcase/analyst-mode-20260923" poster="/shots/analyst-mode-20260923.webp" alt="Analyst mode showing linked reflectivity, velocity, correlation coefficient and differential reflectivity panes" cues={[{ at: 0, text: "Compare four radar products in Analyst." }, { at: 2, text: "Radar restores your earlier single-map view." }, { at: 3, text: "Analyst resumes the four-pane layout." }]} /><p class="capture">Actual app capture · KTLX archive · May 20, 2013</p></div></div></section>
  <section class="phone"><div class="wrap phone-grid"><div data-reveal><p class="eyebrow">HookEcho on Android</p><h2>Radar in your hand.</h2><p>Watch the real phone app switch radar products, open overlays, enter Analyst, and return to the map. Short task sheets keep the weather in view.</p><div class="actions left"><a class="btn btn-primary" href="/go/web/mobile">Open live radar</a><a class="btn" href="/docs/on-your-phone/">Phone guide</a></div></div><div class="device" data-reveal><p class="capture device-credit">Recorded on Samsung Galaxy S24 Ultra</p><picture><source media="(prefers-reduced-motion: reduce)" srcset="/showcase/phone-s24-ultra-20260923.webp" /><img src="/showcase/phone-s24-ultra-20260923.gif" alt="Actual HookEcho Android app on a Galaxy S24 Ultra: switching Reflectivity and Velocity, opening Layers, selecting Analyst panes, then returning to Radar" width="320" height="693" loading="lazy" decoding="async" /></picture></div></div></section>
  <div id="showcase">{features.map((feature, index) => <section class:list={["feature", `feature-${index}`]}><div class="wrap feature-stage" data-reveal><div class="feature-copy"><p class="eyebrow">{feature.eyebrow}</p><h2>{feature.title}</h2><p>{feature.body}</p>{index === 3 && <div class="product-key"><span>Rain intensity</span><span>Motion</span><span>Return similarity</span><span>Motion variation</span></div>}</div><div class="feature-media"><GuidedMedia src={feature.src} poster={feature.poster} alt={feature.alt} cues={feature.cues} /><p class="capture">Guided capture · {feature.note}</p></div></div></section>)}</div>

  <section class="invite"><div class="wrap invite-card"><div><p class="eyebrow">Built in the open</p><h2>Like HookEcho? Join the community.</h2><p>Star the project or meet other weather watchers on Discord.</p></div><div class="actions"><a class="btn" href="/go/hookecho-source/final">☆ Star HookEcho</a><a class="btn" href={DISCORD_INVITE}>Join Discord</a><a class="btn btn-primary" href="/go/web/final">Open live radar</a></div></div></section>
</Base>
<style>
  .eyebrow{color:var(--accent);font-weight:750;letter-spacing:.12em;text-transform:uppercase;font-size:.75rem}.hero{position:relative;overflow:hidden;padding:clamp(2rem,5vw,5rem) 0 2.5rem}.hero-grid{display:grid;grid-template-columns:minmax(20rem,.72fr) minmax(0,1.28fr);align-items:center;gap:clamp(2rem,5vw,5rem)}h1{font-size:clamp(3rem,6.5vw,6.4rem);line-height:.91;letter-spacing:-.06em;margin:.7rem 0 1.4rem}h1 span{color:#a7edff;text-shadow:0 0 35px rgb(82 216 255/.18)}.lede{max-width:610px;color:var(--text-dim);font-size:clamp(1rem,1.6vw,1.22rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center}.actions.left{justify-content:flex-start;margin-top:1.5rem}.community-links{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.75rem}.community-links a{padding:.42rem .7rem;border:1px solid #50d6fc55;border-radius:999px;background:#0b2130;color:#a9ebff;font-size:.78rem;font-weight:650;text-decoration:none}.community-links a:hover{border-color:var(--accent);color:#fff}.micro{color:#7f98aa;font-size:.78rem;margin-top:.7rem}.hero-media{position:relative;min-width:0}.orb{position:absolute;width:75%;aspect-ratio:1;border-radius:50%;background:#1db7ec2b;filter:blur(80px);inset:8% 8% auto auto}.hero-media :global(.guided-frame){box-shadow:0 35px 90px #0009,0 0 0 1px #68dcff18,0 0 55px #2ec7fa18}.capture{color:var(--text-dim);text-align:center;font-size:.72rem;margin:.7rem 0 0}.trust{border-block:1px solid var(--stroke);background:rgb(5 16 25/.5);backdrop-filter:blur(14px)}.trust .wrap{display:flex;justify-content:center;gap:clamp(1rem,6vw,5rem);padding-block:1rem;color:#8eabbc;font-size:.8rem}.feature{position:relative;padding:clamp(4.5rem,8vw,7rem) 0}.feature-stage{position:relative}.feature-copy{position:absolute;z-index:2;left:clamp(1rem,4vw,4rem);top:clamp(1rem,4vw,3rem);width:min(390px,calc(100% - 2rem));padding:clamp(1.2rem,2.5vw,2rem);border:1px solid #63dfff33;border-radius:18px;background:rgb(5 16 26/.82);box-shadow:0 22px 70px #0008;backdrop-filter:blur(18px) saturate(125%)}.feature-0 .feature-stage,.feature-1 .feature-stage,.feature-2 .feature-stage{display:grid;grid-template-columns:minmax(260px,.55fr) minmax(0,1.25fr);align-items:center;gap:clamp(1.5rem,4vw,4rem)}.feature-0 .feature-copy,.feature-1 .feature-copy,.feature-2 .feature-copy{position:relative;inset:auto;width:auto}.feature-1 .feature-copy{order:2}.feature-1 .feature-media{order:1}.feature-3 .feature-copy{position:relative;inset:auto;width:auto;max-width:780px;margin:0 auto 2rem;text-align:center;background:transparent;border:0;box-shadow:none;backdrop-filter:none}.feature-copy h2,.phone h2,.invite h2{font-size:clamp(2rem,4vw,3.6rem);line-height:1.02;margin:.45rem 0 1rem;letter-spacing:-.035em}.feature-copy>p:last-of-type,.phone p,.invite p{color:var(--text-dim);font-size:1.03rem}.feature-media{min-width:0}.product-key{display:flex;justify-content:center;gap:.5rem;flex-wrap:wrap;margin-top:1.4rem}.product-key span{border:1px solid var(--stroke);border-radius:999px;padding:.4rem .7rem;color:#b6c8d4;font-size:.75rem}.phone{padding:clamp(4rem,8vw,7rem) 0;background:radial-gradient(circle at 72% 48%,rgb(31 165 218/.18),transparent 30%)}.phone-grid{display:grid;grid-template-columns:1fr minmax(280px,420px);gap:clamp(3rem,9vw,9rem);align-items:center}.device{padding:14px;border:1px solid #4ecdf45c;border-radius:40px;background:linear-gradient(145deg,#1d3342,#07111a 35% 70%,#183246);box-shadow:0 35px 90px #0009,0 0 45px #32c9f51a}.device .device-credit{margin:0 0 .75rem;color:#a7edff;font-weight:700;letter-spacing:.03em}.device picture img{display:block;width:auto;max-width:100%;height:min(80vh,620px);margin-inline:auto;border-radius:28px}.invite{padding:0 0 clamp(4rem,9vw,8rem)}.invite-card{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,3.5rem);border:1px solid #5ddcff52;border-radius:24px;background:linear-gradient(130deg,rgb(16 45 62/.86),rgb(7 19 29/.82));box-shadow:0 30px 80px #0007, inset 0 1px #b3efff1c;backdrop-filter:blur(18px)}.invite h2{font-size:clamp(1.7rem,3vw,2.7rem)}
  .mode-feature{padding:clamp(4rem,8vw,7rem) 0;background:radial-gradient(circle at 70% 35%,rgb(41 111 163/.16),transparent 40%)}.mode-grid{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);align-items:center;gap:clamp(2rem,5vw,5rem)}.mode-grid h2{font-size:clamp(2rem,4vw,3.6rem);line-height:1.03;letter-spacing:-.035em;margin:.5rem 0 1rem}.mode-grid p:not(.eyebrow):not(.capture){color:var(--text-dim);font-size:1.03rem}.mode-grid>div{min-width:0}
  @media(max-width:800px){.hero{padding:1rem 0 1.5rem}.hero-grid,.mode-grid,.phone-grid,.feature-0 .feature-stage,.feature-1 .feature-stage,.feature-2 .feature-stage{grid-template-columns:1fr}.hero-grid{gap:1rem}h1{font-size:clamp(2.25rem,10.5vw,3.2rem);line-height:.92;margin:.45rem 0 .8rem}.lede{font-size:.94rem;line-height:1.45}.hero-copy .actions{margin-top:.85rem}.micro{margin:.65rem 0 0;font-size:.7rem}.hero-media{margin-top:.25rem}.feature-copy,.feature-1 .feature-copy{position:relative;inset:auto;width:auto;margin:0 0 1rem;order:0}.feature-1 .feature-media{order:0}.feature{padding:3.8rem 0}.invite-card{display:grid}.invite .actions{justify-content:flex-start}.trust .wrap{display:grid;text-align:center;gap:.35rem}.phone-grid{gap:2.5rem}.device{width:min(100%,360px);margin:auto}}
</style>

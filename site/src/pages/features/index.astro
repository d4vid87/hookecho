---
import Base from "../../layouts/Base.astro";

// Keep feature imagery local so the copy and captures deploy as one verified version.
const shots = "/shots";

// Every section opens the real app on the thing it just described. The link vocabulary is the
// app's own #goto grammar (crates/hookecho/src/app.rs, `parse_goto`):
// SITE,lon,lat,zoom[,product|tilt|RFC3339|bm:slug|thr:n|srv]. KTLX is Oklahoma City — the site
// with the most storms to point at.
const app = "https://app.hookecho.io";
const ktlx = (extra = "") => `${app}/#goto=KTLX,-97.28,35.33,8${extra}`;

const sections = [
  {
    id: "radar-mode",
    eyebrow: "Radar mode",
    title: "A clear map for the weather right now",
    body:
      "One map and one timeline are the default. Open the short Radar section for site, " +
      "reflectivity or velocity, tilt, threshold and custom locations. Overlays holds storm " +
      "tracks, MRMS, storm attributes and SPC outlook; Alerts stays closed until you open it.",
    shot: "/shots/radar-mode-20260923.webp",
    alt: "Radar mode with one archived storm map and a short product panel",
    link: { href: ktlx(",thr:16"), label: "Open Radar mode" },
  },
  {
    id: "analyst-mode",
    eyebrow: "Analyst Workstation",
    title: "See one storm through four products",
    body:
      "Open Analyst from the radar map to compare reflectivity, velocity, correlation " +
      "coefficient and differential reflectivity at the same place and time. Velocity can reveal " +
      "a possible rotation signature; the other products add context. Return to Radar in one click.",
    shot: "/shots/analyst-mode-20260923.webp",
    alt: "Analyst Workstation with four radar products and an inspector",
    link: { href: "/docs/radar-and-analyst/", label: "Follow the Analyst guide" },
  },
  {
    id: "radar",
    eyebrow: "Level 2, every tilt",
    title: "The volume, not a picture of it",
    body:
      "HookEcho decodes the raw Level 2 volume from the radar itself: every elevation angle in " +
      "the scan, at full range and full gate resolution, not a pre-rendered image of the lowest " +
      "tilt. Step up through the tilts to see how a storm leans, or put four of them on screen " +
      "at once.",
    shot: "alltilts.jpg",
    alt: "Reflectivity, velocity, correlation coefficient and spectrum width views of the same storm",
    link: { href: ktlx(), label: "Open the radar" },
  },
  {
    id: "velocity",
    eyebrow: "Velocity and dual-pol",
    title: "Investigate rotation, debris, and hail",
    body:
      "Velocity with dealiasing and a storm-relative view for spotting couplets, plus the full " +
      "dual-polarization set — ZDR, CC, KDP and differential phase. Compare products at the same " +
      "location and time; a single color or signature does not confirm a hazard.",
    shot: "velocity.jpg",
    alt: "Storm-relative velocity showing a tight rotation couplet in a supercell",
    link: { href: ktlx(",VEL,srv"), label: "Open storm-relative velocity" },
  },
  {
    id: "mosaic",
    eyebrow: "The whole country",
    title: "MRMS mosaic, rotation tracks and hail",
    body:
      "The national MRMS mosaic at full resolution, with the derived grids that come with it: " +
      "rotation tracks showing where a mesocyclone has been, MESH hail size, and QPE rainfall " +
      "totals for the flooding question.",
    shot: "mrms.jpg",
    alt: "The national MRMS radar mosaic across the United States",
    link: { href: ktlx(), label: "See the mosaic" },
  },
  {
    id: "alerts",
    eyebrow: "Warnings and alerts",
    title: "Every warning polygon, and a phone that tells you",
    body:
      "Watches, warnings, and Special Weather Statements open in a clear glass card with the " +
      "official bulletin already visible, scrollable, and ready to read aloud. Spoken warnings and " +
      "emergencies cover the area within 30 miles of your Home location, with emergencies taking priority. Follow storm reports as they come in and " +
      "spotter positions — drawn on the map rather than buried in a list. Set a rule for your " +
      "own location and the app tells you when a polygon covers it.",
    shot: null,
    alt: "Glass warning reader with the official bulletin immediately visible over live radar",
    link: { href: "/docs/alerts-and-notifications/", label: "How alerts work" },
  },
  {
    id: "storms",
    eyebrow: "Storm interrogation",
    title: "Cells ranked by how dangerous they look",
    body:
      "Every cell in view, sorted by a severity score built from ProbSevere, rotational velocity " +
      "and hail size, so the one worth watching is at the top. Click one for its history, or cut " +
      "a vertical cross-section straight through it to find the overhang and the BWER.",
    shot: "stormtable.jpg",
    alt: "Storm cells listed beside the selected cell’s attributes, visible without expanding a section",
    link: { href: ktlx(), label: "Interrogate a storm" },
  },
  {
    id: "models",
    eyebrow: "Models and soundings",
    title: "HRRR, NAM and the severe parameters",
    body:
      "Model fields drawn over the same map as the radar, with Skew-T soundings and the severe " +
      "composite parameters — CAPE, shear, STP, helicity — so the forecast and the radar are one " +
      "screen instead of two tabs.",
    shot: null,
    alt: "HRRR model fields over the map alongside severe composite parameters",
    link: { href: ktlx(), label: "Open the models" },
  },
  {
    id: "tropical",
    eyebrow: "Tropical",
    title: "NHC tracks, cones and advisories",
    body:
      "Hurricane forecast tracks and cones from the National Hurricane Center, with the advisory " +
      "first in a polished glass reader—official text remains immediately visible and scrollable—" +
      "over the same radar you use for everything else.",
    shot: null,
    alt: "A hurricane forecast cone and track drawn over the map with advisory text alongside",
    link: { href: app, label: "Open the app" },
  },
  {
    id: "archive",
    eyebrow: "Archive and offline",
    title: "Any storm since 1991, and no signal required",
    body:
      "Scrub back through the NOAA archive to any volume since 1991 and replay an event with its " +
      "warnings and reports time-synced. Or build an offline chase pack ahead of time, for the " +
      "part of the day when the data connection is the thing that fails.",
    shot: null,
    alt: "Archive playback with historical warnings and reports replayed alongside the radar",
    link: { href: "/docs/getting-started/", label: "Getting started" },
  },
  {
    id: "android",
    eyebrow: "On Android",
    title: "The same radar, in the field",
    body:
      "Not a stripped-down companion app: the Android build reads the same Level 2 volumes and " +
      "draws the same products, with a layout built for one thumb. Home-screen widget, quick " +
      "settings tile, and warning notifications for where you actually are — which, when you are " +
      "chasing, keeps changing.",
    shot: "/showcase/phone-poster.webp",
    alt: "The Android app: opening to live radar, panning the map and opening a warning",
    link: { href: "/download/", label: "Get the Android build" },
  },
];
---

<Base
  title="Features — HookEcho"
  description="Start with a clear weather radar map, then compare four synchronized products in Analyst. Explore storm tracks, national radar, warnings, archives, and more."
>
  <section class="feature-hero" id="analyst-mode">
    <div class="wrap feature-hero-grid">
      <div><p class="eyebrow">Features / Analyst</p><h1>Read the storm.<br />Layer by layer.</h1><p class="lede">A single map gives you the weather at a glance. Analyst adds synchronized reflectivity, velocity, correlation coefficient, and differential reflectivity so you can investigate possible rotation without losing your place.</p><div class="actions"><a class="btn btn-primary" href="https://app.hookecho.io/">Open live radar</a><a class="btn" href="/docs/storm-analysis/">Start storm analysis</a></div><p class="caption">Actual HookEcho capture · KEAX archive · Clinton, Missouri · April 26, 2024</p></div>
      <img src="/showcase/clinton-four.webp" alt="Four synchronized radar products in HookEcho Analyst" width="1440" height="900" fetchpriority="high" />
    </div>
  </section>
  <section class="feature-index"><div class="wrap"><div class="intro"><p class="eyebrow">Go deeper</p><h2>Every tool has a job.</h2><p>Choose what you need for the question in front of you. The live map stays one click away.</p></div><div class="feature-list">
    {sections.filter((s) => s.id !== "analyst-mode").map((s, index) => <article id={s.id} class="feature-item"><span class="feature-number">{String(index + 1).padStart(2,"0")}</span><div><p class="eyebrow">{s.eyebrow}</p><h3>{s.title}</h3><p>{s.body}</p></div><a href={s.link.href}>{s.link.label} →</a></article>)}
  </div></div></section>
  <section class="feature-end"><div class="wrap"><h2>Try the real radar.</h2><p>No account or installation needed in your browser.</p><div class="actions"><a class="btn btn-primary" href="https://app.hookecho.io/">Open live radar</a><a class="btn" href="/download/">Download HookEcho</a></div></div></section>
</Base>
<style>
  .feature-hero{padding-block:clamp(3rem,6vw,6rem);background:var(--bg-deep)}.feature-hero-grid{display:grid;grid-template-columns:minmax(300px,.7fr) minmax(0,1.3fr);align-items:center;gap:clamp(2rem,5vw,5rem)}.feature-hero h1{font-size:clamp(3rem,4.5vw,4.8rem);line-height:.95;letter-spacing:-.065em}.feature-hero img{display:block;width:100%;border:1px solid var(--stroke-strong)}.lede{font-size:1.1rem;color:var(--text-dim)}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.caption{font-size:.75rem;color:var(--text-dim);margin-top:1rem}.intro{max-width:760px;margin-bottom:2rem}.intro h2,.feature-end h2{font-size:clamp(2.5rem,4vw,4rem);line-height:1.02;letter-spacing:-.055em}.intro>p:last-child,.feature-end p{color:var(--text-dim)}.feature-list{border-top:1px solid var(--stroke)}.feature-item{display:grid;grid-template-columns:50px minmax(0,1fr) auto;align-items:start;gap:1.5rem;padding:1.7rem 0;border-bottom:1px solid var(--stroke);scroll-margin-top:5rem}.feature-number{font-size:.75rem;color:var(--accent);font-weight:750}.feature-item .eyebrow{color:var(--accent);margin:0}.feature-item h3{font-size:1.45rem;margin:.25rem 0 .5rem}.feature-item p:not(.eyebrow){color:var(--text-dim);margin:0;max-width:75ch}.feature-item>a{font-size:.86rem;white-space:nowrap;padding-top:1.5rem}.feature-end{background:var(--surface-1)}
  @media(max-width:800px){.feature-hero-grid{grid-template-columns:1fr}.feature-item{grid-template-columns:30px minmax(0,1fr)}.feature-item>a{grid-column:2;padding:0}.feature-hero h1{font-size:clamp(2.7rem,10vw,4rem)}}
</style>

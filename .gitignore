/target
# Vendored crates and the fuzz workspace bring their own lockfiles; only the root one is
# ours to pin. It is committed: it is what makes the Flathub sources file (and any build)
# reproducible — see packaging/SUBMITTING.md.
Cargo.lock
!/Cargo.lock
*.png
!docs/shots/*.png
!android/app/src/main/res/**/*.png
!crates/hookecho/tests/golden/*.png
!web/icon-*.png
!assets/brand/*.png
!site/public/*.png
!crates/hookecho/data/*.png
/dist
# Browser bundle output (scripts/web/build.sh).
/web/dist/
packaging/appimagetool-*.AppImage

# Android build artifacts (the .so is produced by cargo-ndk; Gradle output is transient).
/android/app/src/main/jniLibs/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
announce-drafts.md

# Generated from web/index.src.html and web/sw.src.js by scripts/web/build.sh (both name the
# content-hashed assets).
/web/index.html
/web/sw.js

# Local puppeteer for scripts/web/smoke.mjs (npm install --no-save).
/node_modules/

# Local flatpak-builder scratch (packaging/flatpak/*.yml built in-repo; the sandbox can't see /tmp).
/.fpbuild/
/.fpstate/
/.fprepo/

# wrangler dev scratch
site/.wrangler/

# Promo clips: 20 MB of MP4 regenerated by `shoot.sh clips`, not repo assets.
docs/clips/

# Generated by scripts/web/build.sh (the committed sources are index.src.html + app.js).
/web/lite/index.html
/web/lite/sites.json

# Local wrangler dev state (scripts/web smoke runs).
/.wrangler/
/node_modules/

# Build output of the excluded strikes relay (it is its own workspace root).
/scripts/strikes-relay/target/

# Local editor/agent tooling config, not part of the project.
/.serena/
